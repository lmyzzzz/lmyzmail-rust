# XDP native build products are generated by crates/lmyzmail/build.rs.
/native/lmyzmail-xdp/.build/

# Native build products are never source evidence.
*.a
*.dll
*.dylib
*.exe
*.lib
*.o
*.obj
*.pdb
*.so

# Local recovery copies and raw profiler/soak captures are not source evidence.
*.orig
/evidence/performance/*.data
/evidence/performance/*.log
/evidence/performance/*.jsonl
/evidence/performance/*.txt
/evidence/performance/smtp-endpoint-throughput-*-smoke-*.json
/evidence/performance/smtp-endpoint-candidate-stability-*-smoke-*.json
/evidence/compatibility/*.jsonl
/evidence/compatibility/smtp-self-stress-*-formal-*.json
