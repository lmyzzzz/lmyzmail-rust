      "retry": ["compare-token", "compare-attempt", "set:task", "del:lease-and-attempt", "srem:processing", "hdel:processing_time", "zadd:retry"],
      "acknowledge": ["compare-token", "compare-attempt", "del:lease-and-attempt", "srem:processing", "hdel:processing_time", "zrem:retry", "del:task"],
      "expired_recovery": ["verify-lease-absent", "srem:processing", "hdel:processing_time", "rpush:pending"],
      "post_send_mutation_failure": "outcome-unknown",
      "mutation_preflight": {
        "operations": ["claim", "renew", "release", "retry", "acknowledge", "expired-recovery", "reconcile"],
        "before_first_write": true,
        "claim_pending_head_preview": "lindex-before-lpop",
        "claim_dynamic_keys": ["lease", "task", "domains"],
        "failure_effect": "all-values-and-ttls-unchanged"
      }
    },
    "candidate_receipts": {
