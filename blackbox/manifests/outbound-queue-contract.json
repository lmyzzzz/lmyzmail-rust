      "ttl": "per-claim",
      "claim": ["lpop:pending", "set:nx:px", "sadd:processing", "hset:processing_time"],
      "renew": ["compare-token", "pexpire", "hset:processing_time", "expire:task-and-domains"],
      "domain_read": ["compare-token", "verify:processing", "hlen:expected", "hstrlen:all", "hget:expected", "validate-all"],
      "domain_update": ["compare-token", "verify:processing", "hlen:expected", "hstrlen:all", "validate-all", "hset-updates", "expire:domains"],
      "retry": ["compare-token", "set:task", "srem:processing", "hdel:processing_time", "zadd:retry"],
      "acknowledge": ["compare-token", "srem:processing", "hdel:processing_time", "zrem:retry", "del:task"],
      "expired_recovery": ["verify-lease-absent", "srem:processing", "hdel:processing_time", "rpush:pending"]
    }
  },
