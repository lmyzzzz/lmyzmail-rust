      "renew": ["compare-token", "compare-attempt", "pexpire", "pexpire-attempt", "hset:processing_time", "expire:task-and-domains"],
      "reconcile": ["bounded-attempt-task", "compare-token", "verify:processing", "bounded-processing-time", "bounded-task-json", "compare-lease-ttls"],
      "release": ["compare-token", "compare-attempt", "del:lease-and-attempt", "srem:processing", "hdel:processing_time", "rpush:pending"],
      "domain_read": ["compare-token", "verify:processing", "hlen:expected", "hstrlen:all", "hget:expected", "validate-all"],
