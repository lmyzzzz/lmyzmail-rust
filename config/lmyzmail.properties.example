# lmyzmail development/installation example. Replace credentials before use.
spring.profiles.include=keywords
lmyzmail.listen.host=127.0.0.1
lmyzmail.http.port=8080
lmyzmail.smtp.port=25
lmyzmail.htcpcp.port=8888
lmyzmail.minecraft.port=25565

# Minecraft 1.8.9 status is disabled unless explicitly enabled. Login and play
# configuration will be admitted only with their corresponding differential suites.
lmyzmail.minecraft.enabled=false
lmyzmail.minecraft.max-players=20
lmyzmail.minecraft.motd=§6LMYZMAIL §7- Send emails in Minecraft
lmyzmail.minecraft.favicon=
lmyzmail.minecraft.read-timeout-seconds=30
lmyzmail.minecraft.auth.max-attempts=5
lmyzmail.minecraft.auth.lockout-seconds=300
lmyzmail.minecraft.auth.window-seconds=600

lmyzmail.htcpcp.enabled=true
lmyzmail.htcpcp.default-brew-time-seconds=30
lmyzmail.htcpcp.pots[0].id=pot-0
lmyzmail.htcpcp.pots[0].type=both
lmyzmail.htcpcp.pots[0].tea-varieties=darjeeling,earl-grey,english-breakfast,green,peppermint,oolong
lmyzmail.htcpcp.pots[0].supported-additions=Cream,Half-and-half,Whole-milk,Part-Skim,Skim,Non-Dairy,Vanilla,Almond,Raspberry,Chocolate,Whisky,Rum,Kahlua,Aquavit,Sugar,Xylitol,Stevia
lmyzmail.htcpcp.pots[1].id=pot-1
lmyzmail.htcpcp.pots[1].type=tea
lmyzmail.htcpcp.pots[1].tea-varieties=darjeeling,earl-grey,peppermint,chamomile,jasmine
lmyzmail.htcpcp.pots[1].supported-additions=Sugar,Xylitol,Stevia
lmyzmail.htcpcp.pots[2].id=pot-2
lmyzmail.htcpcp.pots[2].type=tea
lmyzmail.htcpcp.pots[2].tea-varieties=earl-grey,english-breakfast,darjeeling,chamomile
lmyzmail.htcpcp.pots[2].supported-additions=Cream,Half-and-half,Whole-milk,Part-Skim,Skim,Non-Dairy,Sugar,Xylitol,Stevia
lmyzmail.htcpcp.pots[3].id=pot-3
lmyzmail.htcpcp.pots[3].type=coffee
lmyzmail.htcpcp.pots[3].tea-varieties=
lmyzmail.htcpcp.pots[3].supported-additions=Cream,Half-and-half,Whole-milk,Part-Skim,Skim,Non-Dairy,Vanilla,Almond,Raspberry,Chocolate,Sugar,Xylitol,Stevia
lmyzmail.htcpcp.pots[4].id=pot-4
lmyzmail.htcpcp.pots[4].type=coffee
lmyzmail.htcpcp.pots[4].tea-varieties=
lmyzmail.htcpcp.pots[4].supported-additions=Cream,Whole-milk,Non-Dairy,Chocolate,Whisky,Rum,Kahlua,Aquavit,Sugar
lmyzmail.htcpcp.pots[5].id=pot-5
lmyzmail.htcpcp.pots[5].type=tea
lmyzmail.htcpcp.pots[5].tea-varieties=peppermint,chamomile
lmyzmail.htcpcp.pots[5].supported-additions=Sugar,Xylitol,Stevia
lmyzmail.htcpcp.pots[6].id=pot-6
lmyzmail.htcpcp.pots[6].type=coffee
lmyzmail.htcpcp.pots[6].tea-varieties=
lmyzmail.htcpcp.pots[6].supported-additions=
lmyzmail.htcpcp.pots[7].id=pot-7
lmyzmail.htcpcp.pots[7].type=both
lmyzmail.htcpcp.pots[7].tea-varieties=darjeeling,earl-grey,peppermint,green,oolong,chamomile,jasmine,english-breakfast
lmyzmail.htcpcp.pots[7].supported-additions=Cream,Half-and-half,Whole-milk,Part-Skim,Skim,Non-Dairy,Vanilla,Almond,Raspberry,Chocolate,Whisky,Rum,Kahlua,Aquavit,Sugar,Xylitol,Stevia

lmyzmail.postgres.host=localhost
lmyzmail.postgres.port=5432
lmyzmail.postgres.database=lmyzmail
lmyzmail.postgres.username=lmyzmail
lmyzmail.postgres.password=
lmyzmail.redis.host=localhost
lmyzmail.redis.port=6379
lmyzmail.redis.database=0
# Leave username/password empty for Redis instances without ACL authentication.
lmyzmail.redis.username=
lmyzmail.redis.password=
lmyzmail.redis.tls-enabled=false
lmyzmail.maildir.base=/var/lib/lmyzmail/data/mail
# Large outbound messages remain here until their durable queue result is archived.
lmyzmail.outbound.spool-dir=/var/lib/lmyzmail/data/mail/.lmyzmail-outbound
lmyzmail.outbound.max-pending-tasks=10000
lmyzmail.queue.worker-id=lmyzmail-worker
lmyzmail.queue.max-concurrent-sends=100
lmyzmail.queue.batch-size=50
lmyzmail.queue.poll-interval-ms=1000
lmyzmail.queue.migration-batch-size=1000
lmyzmail.queue.lease-seconds=90
lmyzmail.queue.renew-seconds=10
lmyzmail.queue.processing-timeout-minutes=10
lmyzmail.queue.retry-base-seconds=30
lmyzmail.queue.retry-max-seconds=3600
lmyzmail.outbound.dns.mx.l1-max-entries=10000
lmyzmail.outbound.dns.mx.l1-ttl-minutes=15
lmyzmail.outbound.dns.mx.l2-ttl-minutes=30
lmyzmail.outbound.dns.mx.negative-ttl-minutes=5
lmyzmail.outbound.dns.query-timeout-seconds=15
lmyzmail.outbound.route-deadline-seconds=30
lmyzmail.smtp.mta-sts-fetch-timeout-ms=10000
lmyzmail.maildir.max-files-per-directory=10000
lmyzmail.domain=lmyz.net
lmyzmail.domains.main.receive-enabled=true
lmyzmail.allowed-origins[0]=https://mail.example.com

lmyzmail.http.max-request-bytes=10485760
lmyzmail.http.max-connections=256
lmyzmail.http.request-timeout-ms=10000
lmyzmail.max-email-size-bytes=15728640
lmyzmail.max-attachment-size-bytes=10485760
lmyzmail.max-total-attachments-size-bytes=15728640
lmyzmail.redis.pool.max-active=32
lmyzmail.postgres.pool.max-size=32
lmyzmail.public-registration-enabled=false
lmyzmail.smtp-security.tarpit-enabled=true
lmyzmail.smtp-security.spamhaus-enabled=true
lmyzmail.smtp.mta-sts-enabled=true
# JAVA remains accepted as a legacy alias for the scalar C backend; no JVM is used.
lmyzmail.smtp.skibidi-generator-mode=AUTO_SAFE
lmyzmail.smtp.skibidi-generator-enable-avx512=true
lmyzmail.smtp.skibidi-generator-enable-simd-rng=true
# SkibidiInferX is a Rust SafeTensors/BPE engine; it never starts a JVM.
lmyzmail.skibidi-inferx.enabled=true
lmyzmail.skibidi-inferx.model-path=/usr/share/lmyzmail/models/skibidi-inferx/skibidi_ai.safetensors
lmyzmail.skibidi-inferx.tokenizer-path=/usr/share/lmyzmail/models/skibidi-inferx/tokenizer.json
lmyzmail.skibidi-inferx.temperature=0.85
lmyzmail.skibidi-inferx.top-k=50
lmyzmail.skibidi-inferx.top-p=0.92
# Parsed for legacy configuration parity; the frozen Java engine effectively uses 120.
lmyzmail.skibidi-inferx.max-tokens=80
lmyzmail.skibidi-inferx.timeout-ms=500
lmyzmail.skibidi-inferx.max-concurrent-generations=1
lmyzmail.skibidi-inferx.fallback-on-error=true
lmyzmail.skibidi-inferx.simd-level=auto
lmyzmail.smtp.skibidi-toilet-quiz-enabled=true
lmyzmail.smtp.asciiart.simd-mode=AUTO
lmyzmail.smtp.asciiart.max-width=450
lmyzmail.smtp.asciiart.max-fps=20
lmyzmail.smtp.asciiart.default-width=120
lmyzmail.smtp.asciiart.default-fps=10
lmyzmail.smtp.asciiart.default-contrast=1.2
lmyzmail.smtp.asciiart.char-aspect=2.0
lmyzmail.contentfilter.enabled=true
lmyzmail.contentfilter.suspicious-threshold=5.0
lmyzmail.contentfilter.spam-threshold=10.0
lmyzmail.contentfilter.stream-buffer-size=65536
lmyzmail.contentfilter.rules.RBL_CHECK.enabled=true
lmyzmail.contentfilter.rules.RBL_CHECK.weight=1.0
lmyzmail.contentfilter.rules.NEW_DOMAIN.enabled=true
lmyzmail.contentfilter.rules.NEW_DOMAIN.weight=1.0
lmyzmail.contentfilter.rules.MISSING_HEADERS.enabled=true
lmyzmail.contentfilter.rules.MISSING_HEADERS.weight=1.0
lmyzmail.contentfilter.rules.SUBJECT_ENCODING_TRICK.enabled=true
lmyzmail.contentfilter.rules.SUBJECT_ENCODING_TRICK.weight=1.0
lmyzmail.contentfilter.rules.EXCESSIVE_RECIPIENTS.enabled=true
lmyzmail.contentfilter.rules.EXCESSIVE_RECIPIENTS.weight=1.0
lmyzmail.contentfilter.rules.SPAM_KEYWORDS.enabled=true
lmyzmail.contentfilter.rules.SPAM_KEYWORDS.weight=1.0
lmyzmail.contentfilter.rules.SUSPICIOUS_URL.enabled=true
lmyzmail.contentfilter.rules.SUSPICIOUS_URL.weight=1.0
lmyzmail.contentfilter.rules.DANGEROUS_EXTENSION.enabled=true
lmyzmail.contentfilter.rules.DANGEROUS_EXTENSION.weight=1.0
lmyzmail.contentfilter.rules.DOUBLE_EXTENSION.enabled=true
lmyzmail.contentfilter.rules.DOUBLE_EXTENSION.weight=1.0
lmyzmail.contentfilter.rules.MIME_TYPE_MISMATCH.enabled=true
lmyzmail.contentfilter.rules.MIME_TYPE_MISMATCH.weight=1.0
lmyzmail.contentfilter.rbl.enabled=true
lmyzmail.contentfilter.rbl.servers=zen.spamhaus.org,bl.spamcop.net
lmyzmail.contentfilter.rbl.timeout-ms=3000
lmyzmail.contentfilter.rbl.score-per-hit=3.0
lmyzmail.contentfilter.rbl.max-score=6.0
lmyzmail.contentfilter.keywords.enabled=true
lmyzmail.contentfilter.keywords.base-score=2.0
lmyzmail.contentfilter.keywords.max-score=8.0
lmyzmail.contentfilter.url.enabled=true
lmyzmail.contentfilter.url.shortener-score=1.5
lmyzmail.contentfilter.url.suspicious-tld-score=2.0
lmyzmail.contentfilter.url.ip-url-score=3.0
lmyzmail.contentfilter.url.max-score=8.0
lmyzmail.contentfilter.attachment.enabled=true
lmyzmail.contentfilter.attachment.dangerous-extensions=exe,scr,bat,cmd,com,pif,vbs,vbe,js,jse,wsf,wsh,msi,msp,hta,cpl,reg,inf,scf,lnk,ps1,psm1,jar
lmyzmail.contentfilter.attachment.dangerous-extension-score=5.0
lmyzmail.contentfilter.attachment.double-extension-score=4.0
lmyzmail.contentfilter.attachment.mime-type-mismatch-score=3.0
lmyzmail.xdp.enabled=false
lmyzmail.xdp.interface-name=eth0
# Leave empty to use the BPF object embedded in the lmyzmail binary.
lmyzmail.xdp.bpf-object-path=
lmyzmail.xdp.pin-path=/sys/fs/bpf/lmyzmail
lmyzmail.xdp.ban-threshold=50
# -1 derives ban-threshold / 2.
lmyzmail.xdp.unban-threshold=-1
lmyzmail.xdp.force-generic-mode=false
lmyzmail.xdp.verbose=false
lmyzmail.xdp.sync-on-startup=true
lmyzmail.xdp.whitelist=127.0.0.1,::1
lmyzmail.xdp.reason-code-default=0
lmyzmail.xdp.reason-code-pps-overlimit=5
lmyzmail.xdp.reason-code-syn-flood=6
lmyzmail.xdp.pps-monitor.enabled=true
lmyzmail.xdp.pps-monitor.poll-interval-ms=1000
lmyzmail.xdp.pps-monitor.pps-warn-threshold=100000
lmyzmail.xdp.pps-monitor.pps-critical-threshold=200000
lmyzmail.xdp.pps-monitor.syn-pps-warn-threshold=10000
lmyzmail.xdp.pps-monitor.syn-pps-critical-threshold=20000
lmyzmail.xdp.pps-monitor.per-ip-pps-warn-threshold=1000
lmyzmail.xdp.pps-monitor.per-ip-pps-critical-threshold=5000
lmyzmail.xdp.pps-monitor.per-ip-syn-pps-warn-threshold=100
lmyzmail.xdp.pps-monitor.per-ip-syn-pps-critical-threshold=500
lmyzmail.xdp.pps-monitor.consecutive-exceed-count=3
lmyzmail.xdp.pps-monitor.record-to-cringe=true
lmyzmail.xdp.pps-monitor.max-ips-per-poll=10000
lmyzmail.xdp.pps-monitor.ring-buffer-size=1024

# Current threat scores decay by 10 points after each 24-hour interval. When
# check-interval is omitted, lmyzmail derives interval/4 clamped to 1m..1h.
lmyzmail.cringe.decay.interval=24h
lmyzmail.cringe.decay.amount=10
# lmyzmail.cringe.decay.check-interval=1h
lmyzmail.cringe.decay.activity-retention-days=360

# Monitor the first readable SSH log and begin at EOF. All queues and tracked
# state remain bounded even when the input log is adversarial.
lmyzmail.fail2ban.enabled=false
lmyzmail.fail2ban.ssh-log-paths=/var/log/auth.log,/var/log/secure,/var/log/messages
lmyzmail.fail2ban.scan-interval=10s
lmyzmail.fail2ban.max-retries=5
lmyzmail.fail2ban.find-time=10m
lmyzmail.fail2ban.report-cooldown=5m
lmyzmail.fail2ban.max-tracked-ips=10000
lmyzmail.fail2ban.cleanup-interval=5m
lmyzmail.reporting.enabled=false
lmyzmail.reporting.auto-send-enabled=false
lmyzmail.reporting.batch-size=500
lmyzmail.reporting.flush-interval-ms=2000
lmyzmail.reporting.retention-days=90
lmyzmail.reporting.min-volume-for-report=10
lmyzmail.reporting.dmarc-report-sender-address=
lmyzmail.reporting.dmarc-report-sender-password=
lmyzmail.reporting.tls-report-sender-address=
lmyzmail.reporting.tls-report-sender-password=
lmyzmail.reporting.organization-name=
lmyzmail.reporting.organization-email=
# Optional numeric IP:port override; leave empty to use the system DNS resolver.
lmyzmail.reporting.dns-server=
lmyzmail.reporting.http-delivery-enabled=false
lmyzmail.reporting.http-delivery-timeout-seconds=30
lmyzmail.show-internet-nl-badge=false

# API keys are intentionally absent from this example. Inject them through a
# protected deployment-specific file or command-line property override.
