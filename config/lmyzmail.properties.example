# lmyzmail development/installation example. Replace credentials before use.
lmyzmail.listen.host=127.0.0.1
lmyzmail.http.port=8080
lmyzmail.smtp.port=25
lmyzmail.htcpcp.port=8888
lmyzmail.minecraft.port=25565

lmyzmail.postgres.host=localhost
lmyzmail.postgres.port=5432
lmyzmail.postgres.database=lmyzmail
lmyzmail.postgres.username=lmyzmail
lmyzmail.postgres.password=
lmyzmail.redis.host=localhost
lmyzmail.redis.port=6379
lmyzmail.redis.database=0
# Leave username/password empty for Redis instances without ACL authentication.
lmyzmail.redis.username=
lmyzmail.redis.password=
lmyzmail.redis.tls-enabled=false
lmyzmail.maildir.base=/var/lib/lmyzmail/data/mail
# Large outbound messages remain here until their durable queue result is archived.
lmyzmail.outbound.spool-dir=/var/lib/lmyzmail/data/mail/.lmyzmail-outbound
lmyzmail.outbound.max-pending-tasks=10000
lmyzmail.queue.worker-id=lmyzmail-worker
lmyzmail.queue.max-concurrent-sends=100
lmyzmail.queue.batch-size=50
lmyzmail.queue.poll-interval-ms=1000
lmyzmail.queue.migration-batch-size=1000
lmyzmail.queue.lease-seconds=90
lmyzmail.queue.renew-seconds=10
lmyzmail.queue.processing-timeout-minutes=10
lmyzmail.queue.retry-base-seconds=30
lmyzmail.queue.retry-max-seconds=3600
lmyzmail.outbound.dns.mx.l1-max-entries=10000
lmyzmail.outbound.dns.mx.l1-ttl-minutes=15
lmyzmail.outbound.dns.mx.l2-ttl-minutes=30
lmyzmail.outbound.dns.mx.negative-ttl-minutes=5
lmyzmail.outbound.dns.query-timeout-seconds=15
lmyzmail.outbound.route-deadline-seconds=30
lmyzmail.smtp.mta-sts-fetch-timeout-ms=10000
lmyzmail.maildir.max-files-per-directory=10000
lmyzmail.domain=lmyz.net
lmyzmail.allowed-origins[0]=https://mail.example.com

lmyzmail.http.max-request-bytes=10485760
lmyzmail.http.max-connections=256
lmyzmail.http.request-timeout-ms=10000
lmyzmail.max-email-size-bytes=15728640
lmyzmail.max-attachment-size-bytes=10485760
lmyzmail.max-total-attachments-size-bytes=15728640
lmyzmail.redis.pool.max-active=32
lmyzmail.postgres.pool.max-size=32
lmyzmail.public-registration-enabled=false
lmyzmail.smtp-security.tarpit-enabled=true
lmyzmail.smtp-security.spamhaus-enabled=true
lmyzmail.smtp.mta-sts-enabled=true
lmyzmail.smtp.skibidi-generator-mode=AUTO_SAFE
lmyzmail.xdp.enabled=false
lmyzmail.fail2ban.enabled=false
lmyzmail.reporting.http-delivery-enabled=false
lmyzmail.show-internet-nl-badge=false

# API keys are intentionally absent from this example. Inject them through a
# protected deployment-specific file or command-line property override.
