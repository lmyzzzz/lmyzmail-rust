  "contract": {
    "phase": "BODY",
    "order": [
      "SPAM_KEYWORDS",
      "SUSPICIOUS_URL"
    ],
    "keyword_scoring": "min(min(spam_hits * 0.5, base_score) + min(phishing_hits, base_score * 1.5) + max(density - threshold, 0) * 10, max_score) * rule_weight",
    "keyword_hits": "each configured phrase counts at most once per physical line",
    "url_deduplication": "exact case-sensitive URL bytes after UTF-8 text decoding",
    "url_scoring": "cap each shortener, suspicious-TLD, and IP category at max_score / 2; cap aggregate at max_score; then apply rule weight",
    "non_text_mime": "skip ordinary binary parts and message/global; scan text and HTML-like leaves as raw transfer-encoded bytes; decode only encoded message/rfc822 containers",
    "multipart_digest_default": "a child without Content-Type defaults to message/rfc822",
    "attachment_index": "preserve the Java 256 KiB header-only window, global multipart part count, and stop at the first actual body callback",
    "header_format": "Java-compatible one-decimal half-up formatting",
    "approved_security_difference": "smtp-mime-bounded-work"
  },
  "bounds": {
    "keyword_line_utf16_units": 8192,
    "url_line_utf16_units": 16384,
    "unique_urls": 500,
    "mime_parts": 4096,
    "active_mime_boundaries": 64,
    "mime_boundary_bytes": 200,
    "mime_header_bytes_per_entity": 65536,
    "mime_header_fields_per_entity": 256,
    "mime_relevant_field_bytes": 8192,
    "embedded_message_depth": 64,
    "decoded_work_bytes": 67108864,
    "attachment_index_input_bytes": 262144,
    "configured_entries_per_list": 4096,
    "configured_entry_bytes": 512,
    "overflow": "controlled delivery error, never a clean result"
  },
  "behavior_difference": {
    "id": "smtp-mime-bounded-work",
    "frozen_definition_tree_sha256": "2c52c81d562b8a590d06cb21cadd99481ed91f20e3077ca9c09322c6eca37c7c",
    "candidate_requirement": "Parse MIME with at most 4096 entities, 64 active multipart boundaries, 200 bytes per boundary, 65536 bytes and 256 fields per entity header, 8192 bytes per relevant field, 64 nested message/rfc822 entities, and 67108864 aggregate decoded-work bytes. Reject an exceeded budget with a controlled delivery error. Preserve the frozen 262144-byte header-only indexing window.",
    "oracle_behavior": "The frozen BODY dispatcher configures Mime4j with unlimited line length, header length, header count, and content length and catches parser failures as a clean partial result. Its separate header-only email indexer limits raw input to 262144 bytes and headers to 1000 fields but does not bound nested MIME entities or aggregate transfer-decoding work.",
    "reason": "Adversarial multipart and recursively encoded message/rfc822 input can otherwise consume unbounded parser state, allocation, or CPU relative to the accepted message. Silent fail-open also lets a resource-exhaustion payload bypass enabled BODY rules.",
    "scope": "Only MIME input that exceeds an explicit candidate parser or decoded-work budget. Raw transfer-encoded text leaves, encoded message/rfc822 traversal, message/global handling, multipart/digest defaults, boundary semantics, BODY rule order and scoring, first-body attachment indexing, and all in-budget storage effects remain differential requirements.",
    "candidate_tests": [
      "smtp_content_filter::tests::content_filter_body_parser_enforces_header_and_boundary_budgets",
      "smtp_content_filter::tests::content_filter_body_part_budget_is_an_error_not_fail_open",
      "smtp_content_filter::tests::first_attachment_scan_enforces_embedded_depth_and_decoded_work_budgets",
      "smtp_content_filter::tests::first_attachment_scan_matches_the_java_256_kib_index_window",
      "smtp_content_filter::tests::first_attachment_scan_resumes_siblings_after_an_empty_multipart"
    ],
    "oracle_sources": {
      "src/main/java/net/lmyz/lmyzmail/contentfilter/pipeline/StreamingBodyDispatcher.java": "c439826259e76acdf417dca11321375601674df8c76d4a1843e5d0a9a5e09b6a",
