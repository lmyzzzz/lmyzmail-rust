+import net.lmyz.lmyzmail.mailbox.repo.EmailIndexRepository;
+import net.lmyz.lmyzmail.mailbox.service.MailboxService;
+import net.lmyz.lmyzmail.outbound.OutboundMailService;
+import net.lmyz.lmyzmail.ratelimit.RateLimitService;
+import org.junit.jupiter.api.Test;
+import org.springframework.transaction.PlatformTransactionManager;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.ArrayDeque;
+import java.util.Map;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class StressTestControllerSecurityTest {
+
+    @Test
+    void stressMutationsRequireWritePermissionWhileStatusRequiresReadPermission()
+            throws Exception {
+        assertPermission("startStressTest", false, true);
+        assertPermission("resetRoundCounter", false, true);
+        assertPermission("manualCleanup", false, true);
+        assertPermission("getStatus", true, false);
+    }
+
+    @Test
+    void senderBypassDoesNotClearGlobalLoginOrSmtpProtection() throws Exception {
+        RateLimitProperties rateProperties = mock(RateLimitProperties.class);
+        when(rateProperties.isInboundEnabled()).thenReturn(false);
+        RateLimitService rateLimitService = new RateLimitService(
+                rateProperties, mock(MailStoreProperties.class));
+
+        Map<String, Bucket> loginBuckets = mapField(rateLimitService, "loginFailBuckets");
+        Map<String, Bucket> principalBuckets = mapField(
+                rateLimitService, "principalLoginFailBuckets");
+        Map<String, Object> smtpErrors = mapField(rateLimitService, "smtpErrorsByIp");
+        Map<String, Instant> smtpBlocks = mapField(rateLimitService, "smtpBlockedIps");
+        Map<String, Bucket> emailBuckets = mapField(rateLimitService, "emailBuckets");
+
+        loginBuckets.put("203.0.113.10", mock(Bucket.class));
+        principalBuckets.put("203.0.113.10\0victim@example.test", mock(Bucket.class));
+        smtpErrors.put("203.0.113.11", new ArrayDeque<>());
+        smtpBlocks.put("203.0.113.12", Instant.now().plusSeconds(60));
+        emailBuckets.put("unrelated@example.test", mock(Bucket.class));
+
+        StressTestController controller = newController(rateLimitService);
+        Method bypass = StressTestController.class.getDeclaredMethod(
+                "bypassRateLimits", String.class);
+        bypass.setAccessible(true);
+        bypass.invoke(controller, "stress@example.test");
+
+        assertThat(loginBuckets).containsKey("203.0.113.10");
+        assertThat(principalBuckets)
+                .containsKey("203.0.113.10\0victim@example.test");
+        assertThat(smtpErrors).containsKey("203.0.113.11");
+        assertThat(smtpBlocks).containsKey("203.0.113.12");
+        assertThat(emailBuckets)
+                .containsKeys("unrelated@example.test", "stress@example.test");
+    }
+
+    private static void assertPermission(String methodName, boolean read, boolean write)
+            throws Exception {
+        RequireApiPermission permission = StressTestController.class
+                .getDeclaredMethod(methodName)
+                .getAnnotation(RequireApiPermission.class);
+        assertThat(permission).as("permission on %s", methodName).isNotNull();
+        assertThat(permission.read()).isEqualTo(read);
+        assertThat(permission.write()).isEqualTo(write);
+    }
+
+    private static StressTestController newController(RateLimitService rateLimitService) {
+        BotmailProperties properties = mock(BotmailProperties.class);
+        OutboundMailService outboundMailService = mock(OutboundMailService.class);
+        when(outboundMailService.getTempDir()).thenReturn(Path.of("."));
+        return new StressTestController(
+                properties,
+                outboundMailService,
+                mock(MailboxService.class),
+                rateLimitService,
+                mock(EmailIndexRepository.class),
+                mock(MailFileStore.class),
+                mock(PlatformTransactionManager.class));
+    }
+
+    @SuppressWarnings("unchecked")
+    private static <K, V> Map<K, V> mapField(Object target, String name) throws Exception {
+        Field field = RateLimitService.class.getDeclaredField(name);
+        field.setAccessible(true);
+        return (Map<K, V>) field.get(target);
+    }
+}
