+        AuthorizationResult result;
+        try {
+            result = largeUploadAuthorizer.test(token)
+                    ? AuthorizationResult.AUTHORIZED
+                    : AuthorizationResult.UNAUTHORIZED;
+        } catch (RuntimeException e) {
+            result = AuthorizationResult.UNAUTHORIZED;
+        }
+        scheduleAuthorizationResult(ctx, generation, result);
+    }
+
+    private void scheduleAuthorizationResult(ChannelHandlerContext ctx,
+                                             long generation,
+                                             AuthorizationResult result) {
+        try {
+            ctx.executor().execute(
+                    () -> authorizationComplete(ctx, generation, result));
+        } catch (RejectedExecutionException ignored) {
+            // A terminating event loop will invoke channelInactive/handlerRemoved,
+            // which releases all messages retained by this handler.
+        }
+    }
+
+    private void authorizationComplete(ChannelHandlerContext ctx,
+                                       long generation,
+                                       AuthorizationResult result) {
