+        ctx.fireChannelRead(msg);
+        if (msg instanceof LastHttpContent) {
+            resetRequestBudget();
+        }
+    }
+
+    private void beginAuthorization(ChannelHandlerContext ctx, Object request, String token) {
+        awaitingAuthorization = true;
+        restoreAutoRead = ctx.channel().config().isAutoRead();
+        if (restoreAutoRead) {
