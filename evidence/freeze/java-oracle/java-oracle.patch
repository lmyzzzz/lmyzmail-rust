--- /dev/null
+++ b/src/test/java/net/lmyz/lmyzmail/inbound/MtaStsServiceSecurityTest.java
@@ -0,0 +1,175 @@
+package net.lmyz.lmyzmail.inbound;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.data.redis.core.StringRedisTemplate;
+import org.springframework.data.redis.core.ValueOperations;
+import org.xbill.DNS.DClass;
+import org.xbill.DNS.Name;
+import org.xbill.DNS.Record;
+import org.xbill.DNS.Resolver;
+import org.xbill.DNS.TXTRecord;
+
+import java.io.IOException;
+import java.time.Duration;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+class MtaStsServiceSecurityTest {
+
+    @Test
+    void policyDecoderRejectsBodiesAboveTheTransportBudget() {
+        byte[] oversized = new byte[MtaStsService.MAX_POLICY_BYTES + 1];
+
+        assertThatThrownBy(() -> MtaStsService.decodePolicyBody(oversized))
+                .isInstanceOf(IOException.class)
+                .hasMessageContaining("exceeds");
+    }
+
+    @Test
+    void policyAtTheByteLimitRemainsCompatible() throws Exception {
+        byte[] policy = new byte[MtaStsService.MAX_POLICY_BYTES];
+        Arrays.fill(policy, (byte) 'a');
+
+        String result = MtaStsService.decodePolicyBody(policy);
+
+        assertThat(result).hasSize(MtaStsService.MAX_POLICY_BYTES);
+    }
+
+    @Test
+    void dnsRecordMustHaveOneExactVersionAndRfcCompliantId() throws Exception {
+        String valid = "v=STSv1; id=Policy123;";
+        String anotherValid = "v=STSv1; id=Policy456;";
+
+        assertThat(MtaStsService.selectMtaStsDnsRecord(new Record[]{txt(valid)}))
+                .isEqualTo(valid);
+        assertThat(MtaStsService.selectMtaStsDnsRecord(new Record[]{
+                txt("v=STSv10; id=Ignored;"), txt(valid)}))
+                .isEqualTo(valid);
+        assertThat(MtaStsService.selectMtaStsDnsRecord(new Record[]{
+                txt(valid), txt(anotherValid)}))
+                .isNull();
+
+        assertThat(MtaStsService.parseDnsRecordId("xv=STSv1; id=Policy123;")).isNull();
+        assertThat(MtaStsService.parseDnsRecordId(" v=STSv1; id=Policy123;")).isNull();
+        assertThat(MtaStsService.parseDnsRecordId("v=stsv1; id=Policy123;")).isNull();
+        assertThat(MtaStsService.parseDnsRecordId("v=STSv1evil; id=Policy123;")).isNull();
+        assertThat(MtaStsService.parseDnsRecordId("v=STSv1\n; id=Policy123;")).isNull();
+        assertThat(MtaStsService.parseDnsRecordId(
+                "v=STSv1; id=" + "a".repeat(32) + ";")).hasSize(32);
+        assertThat(MtaStsService.parseDnsRecordId(
+                "v=STSv1; id=" + "a".repeat(33) + ";")).isNull();
+        assertThat(MtaStsService.parseDnsRecordId("v=STSv1; id=bad-id;")).isNull();
+    }
+
+    @Test
+    void policyFetchRequiresAnExactPlainTextMediaType() {
+        assertThat(MtaStsService.isPlainTextPolicyContentType("text/plain")).isTrue();
+        assertThat(MtaStsService.isPlainTextPolicyContentType(
+                "TEXT/PLAIN; charset=utf-8")).isTrue();
+        assertThat(MtaStsService.isPlainTextPolicyContentType(null)).isFalse();
+        assertThat(MtaStsService.isPlainTextPolicyContentType("text/html")).isFalse();
+        assertThat(MtaStsService.isPlainTextPolicyContentType("text/plain.evil")).isFalse();
+    }
+
+    @Test
+    void firstNonRepeatablePolicyFieldsWinAndZeroMaxAgeIsValid() {
+        MtaStsService service = newService();
+
+        MtaStsService.MtaStsPolicy policy = service.parsePolicyFile("""
+                version: STSv1
+                version: invalid
+                mode: enforce
+                mode: none
+                mx: mx.example
+                max_age: 0
+                max_age: 600
+                """, "Policy123");
+
+        assertThat(policy).isNotNull();
+        assertThat(policy.version()).isEqualTo("STSv1");
+        assertThat(policy.mode()).isEqualTo(MtaStsService.PolicyMode.ENFORCE);
+        assertThat(policy.maxAgeSeconds()).isZero();
+    }
+
+    @Test
+    void invalidFirstPolicyFieldCannotBeRescuedByADuplicate() {
+        MtaStsService service = newService();
+
+        assertThat(service.parsePolicyFile("""
+                version: invalid
+                version: STSv1
+                mode: enforce
+                mx: mx.example
+                max_age: 60
+                """, "Policy123")).isNull();
+        assertThat(service.parsePolicyFile("""
+                version: STSv1
+                mode: invalid
+                mode: enforce
+                mx: mx.example
+                max_age: 60
+                """, "Policy123")).isNull();
+        assertThat(service.parsePolicyFile("""
+                version: STSv1
+                mode: enforce
+                mx: mx.example
+                max_age: -1
+                max_age: 60
+                """, "Policy123")).isNull();
+    }
+
+    @Test
+    void zeroMaxAgePolicyAppliesNowButIsNotCached() {
+        StringRedisTemplate redisTemplate = mock(StringRedisTemplate.class);
+        @SuppressWarnings("unchecked")
+        ValueOperations<String, String> valueOperations = mock(ValueOperations.class);
+        when(redisTemplate.opsForValue()).thenReturn(valueOperations);
+        when(valueOperations.get(anyString())).thenReturn(null);
+
+        SmtpProperties properties = new SmtpProperties();
+        properties.setMtaStsEnabled(true);
+        AtomicInteger fetchCount = new AtomicInteger();
+        MtaStsService.MtaStsPolicy zeroMaxAgePolicy = new MtaStsService.MtaStsPolicy(
+                "STSv1",
+                MtaStsService.PolicyMode.ENFORCE,
+                List.of("mx.example"),
+                0,
+                "Policy123",
+                System.currentTimeMillis());
+
+        MtaStsService service = new MtaStsService(
+                redisTemplate, properties, mock(Resolver.class)) {
+            @Override
+            MtaStsPolicy fetchPolicy(String domain) {
+                fetchCount.incrementAndGet();
+                return zeroMaxAgePolicy;
+            }
+        };
+        service.init();
+
+        assertThat(service.getPolicy("example.com")).isEqualTo(zeroMaxAgePolicy);
+        assertThat(service.getPolicy("example.com")).isEqualTo(zeroMaxAgePolicy);
+        assertThat(fetchCount).hasValue(2);
+        verify(valueOperations, never()).set(anyString(), anyString(), any(Duration.class));
+    }
+
+    private static MtaStsService newService() {
+        return new MtaStsService(
+                mock(StringRedisTemplate.class), new SmtpProperties(), mock(Resolver.class));
+    }
+
+    private static TXTRecord txt(String value) throws Exception {
+        return new TXTRecord(
+                Name.fromString("_mta-sts.example."), DClass.IN, 60, List.of(value));
+    }
+}
