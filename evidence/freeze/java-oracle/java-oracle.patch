+import javax.net.ssl.SSLParameters;
+import javax.net.ssl.SSLSocket;
+import javax.net.ssl.SSLSocketFactory;
+import java.io.BufferedInputStream;
+import java.io.BufferedOutputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.EOFException;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InterruptedIOException;
+import java.io.OutputStream;
+import java.net.IDN;
+import java.net.InetAddress;
+import java.net.InetSocketAddress;
+import java.net.Socket;
+import java.net.SocketTimeoutException;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.Future;
+import java.util.concurrent.RejectedExecutionException;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * Minimal HTTP/1.1 client that connects to the exact IP addresses that passed
+ * {@link NetworkValidator}. The original hostname is retained for the Host
+ * header, TLS SNI and HTTPS endpoint identification, which closes the DNS
+ * rebinding gap caused by validating one lookup and letting another client
+ * resolve the hostname again.
+ */
+public final class PinnedHttpClient {
+
+    private static final int MAX_RESPONSE_HEADER_BYTES = 64 * 1024;
+    private static final int MAX_RESPONSE_HEADER_LINES = 200;
+    private static final int MAX_LINE_BYTES = 8 * 1024;
+    private static final int MAX_INTERIM_RESPONSES = 5;
+    private static final int MAX_ADDRESS_ATTEMPTS = 16;
+    private static final int DNS_THREADS = 4;
+    private static final int DNS_QUEUE_CAPACITY = 64;
+    private static final AtomicInteger DNS_THREAD_SEQUENCE = new AtomicInteger();
+    private static final ThreadPoolExecutor DNS_EXECUTOR = new ThreadPoolExecutor(
+            DNS_THREADS,
+            DNS_THREADS,
+            0L,
+            TimeUnit.MILLISECONDS,
+            new ArrayBlockingQueue<>(DNS_QUEUE_CAPACITY),
+            task -> Thread.ofPlatform()
+                    .daemon(true)
+                    .name("pinned-http-dns-" + DNS_THREAD_SEQUENCE.incrementAndGet())
+                    .unstarted(task),
+            new ThreadPoolExecutor.AbortPolicy());
+
+    private PinnedHttpClient() {}
+
+    public record Response(int statusCode,
+                           Map<String, List<String>> headers,
+                           byte[] body) {
+        public Response {
+            Map<String, List<String>> copy = new LinkedHashMap<>();
+            headers.forEach((name, values) -> copy.put(
+                    name.toLowerCase(Locale.ROOT), List.copyOf(values)));
+            headers = Collections.unmodifiableMap(copy);
+            body = body.clone();
+        }
+
+        @Override
+        public byte[] body() {
+            return body.clone();
+        }
+
+        public String firstHeader(String name) {
+            if (name == null) return null;
+            List<String> values = headers.get(name.toLowerCase(Locale.ROOT));
+            return values == null || values.isEmpty() ? null : values.getFirst();
+        }
+    }
+
+    public static Response get(URI uri,
+                               Map<String, String> requestHeaders,
+                               Duration timeout,
+                               int maxResponseBodyBytes) throws IOException {
+        Deadline deadline = Deadline.start(timeout);
+        InetAddress[] addresses = resolvePublicAddresses(uri, deadline);
+        return executePinned(uri, addresses, "GET", requestHeaders,
+                new byte[0], deadline, maxResponseBodyBytes);
+    }
+
+    public static Response post(URI uri,
+                                 Map<String, String> requestHeaders,
+                                 byte[] requestBody,
+                                 Duration timeout,
+                                 int maxResponseBodyBytes) throws IOException {
+        Deadline deadline = Deadline.start(timeout);
+        InetAddress[] addresses = resolvePublicAddresses(uri, deadline);
+        return executePinned(uri, addresses, "POST", requestHeaders,
+                requestBody == null ? new byte[0] : requestBody,
+                deadline, maxResponseBodyBytes);
+    }
+
+    private static InetAddress[] resolvePublicAddresses(URI uri, Deadline deadline) throws IOException {
+        String host = normalizedHost(uri);
+        Future<InetAddress[]> resolution;
+        try {
+            resolution = DNS_EXECUTOR.submit(() -> NetworkValidator.resolveAndValidateAll(host));
+        } catch (RejectedExecutionException e) {
+            throw new IOException("HTTP DNS resolver is saturated", e);
+        }
+
+        try {
+            return resolution.get(deadline.remainingMillis(), TimeUnit.MILLISECONDS);
+        } catch (SocketTimeoutException e) {
+            cancelDnsResolution(resolution, DNS_EXECUTOR);
+            throw e;
+        } catch (TimeoutException e) {
+            cancelDnsResolution(resolution, DNS_EXECUTOR);
+            throw deadline.timeout("HTTP DNS resolution deadline exceeded", e);
+        } catch (InterruptedException e) {
+            cancelDnsResolution(resolution, DNS_EXECUTOR);
+            Thread.currentThread().interrupt();
+            InterruptedIOException interrupted =
+                    new InterruptedIOException("Interrupted during HTTP DNS resolution");
+            interrupted.initCause(e);
+            throw interrupted;
+        } catch (ExecutionException e) {
+            Throwable cause = e.getCause();
+            if (cause instanceof SecurityException securityException) {
+                throw securityException;
+            }
+            if (cause instanceof IOException ioException) {
+                throw ioException;
+            }
+            if (cause instanceof IllegalArgumentException illegalArgumentException) {
+                throw new IOException("Invalid HTTP target: "
+                        + illegalArgumentException.getMessage(), illegalArgumentException);
+            }
+            throw new IOException("HTTP DNS resolution failed", cause);
+        }
+    }
+
+    static void cancelDnsResolution(Future<?> resolution, ThreadPoolExecutor executor) {
+        if (resolution == null) return;
+        resolution.cancel(true);
+        if (executor != null) {
+            if (resolution instanceof Runnable queuedTask) {
+                executor.remove(queuedTask);
+            }
+            executor.purge();
+        }
+    }
+
+    /** Package-private for a loopback server regression test; production callers resolve above. */
+    static Response executePinned(URI uri,
+                                  InetAddress[] addresses,
+                                  String method,
+                                  Map<String, String> requestHeaders,
+                                  byte[] requestBody,
+                                  Duration timeout,
+                                  int maxResponseBodyBytes) throws IOException {
+        return executePinned(uri, addresses, method, requestHeaders, requestBody,
+                Deadline.start(timeout), maxResponseBodyBytes);
+    }
+
+    private static Response executePinned(URI uri,
+                                          InetAddress[] addresses,
+                                          String method,
+                                          Map<String, String> requestHeaders,
+                                          byte[] requestBody,
+                                          Deadline deadline,
+                                          int maxResponseBodyBytes) throws IOException {
+        if (addresses == null || addresses.length == 0) {
+            throw new IOException("HTTP target has no validated addresses");
+        }
+        if (maxResponseBodyBytes < 0) {
+            throw new IllegalArgumentException("Negative HTTP response limit");
+        }
+        String host = normalizedHost(uri);
+        String scheme = normalizedScheme(uri);
+        int port = effectivePort(uri, scheme);
+        AtomicReference<Socket> activeSocket = new AtomicReference<>();
+        AtomicBoolean deadlineTriggered = new AtomicBoolean();
+        Thread watchdog = startDeadlineWatchdog(deadline, activeSocket, deadlineTriggered);
+
+        try (Socket socket = connectPinned(addresses, host, port,
+                "https".equals(scheme), deadline, activeSocket)) {
+            activeSocket.set(socket);
+            socket.setSoTimeout(deadline.remainingMillis());
+            OutputStream output = new BufferedOutputStream(socket.getOutputStream());
+            writeRequest(output, uri, host, port, scheme, method,
+                    requestHeaders == null ? Map.of() : requestHeaders,
+                    requestBody == null ? new byte[0] : requestBody);
+            output.flush();
+
+            InputStream input = new BufferedInputStream(socket.getInputStream());
+            ResponseHead head = readFinalResponseHead(input);
+            byte[] body = maxResponseBodyBytes == 0 || hasNoResponseBody(method, head.statusCode())
+                     ? new byte[0]
+                     : readResponseBody(input, head.headers(), maxResponseBodyBytes);
+            return new Response(head.statusCode(), head.headers(), body);
+        } catch (IOException e) {
+            if (deadlineTriggered.get() || deadline.isExpired()) {
+                throw deadline.timeout("HTTP request deadline exceeded", e);
+            }
+            throw e;
+        } finally {
+            activeSocket.set(null);
+            watchdog.interrupt();
+        }
+    }
+
+    private static Socket connectPinned(InetAddress[] addresses,
+                                         String host,
+                                         int port,
+                                         boolean tls,
+                                         Deadline deadline,
+                                         AtomicReference<Socket> activeSocket) throws IOException {
+        IOException lastFailure = null;
+        int attempts = Math.min(addresses.length, MAX_ADDRESS_ATTEMPTS);
+        for (int i = 0; i < attempts; i++) {
+            Socket candidate = new Socket();
+            Socket plain = candidate;
+            activeSocket.set(candidate);
+            try {
+                plain.connect(new InetSocketAddress(addresses[i], port), deadline.remainingMillis());
+                plain.setSoTimeout(deadline.remainingMillis());
+                if (!tls) {
+                    return plain;
+                }
+
+                SSLSocket ssl = (SSLSocket) ((SSLSocketFactory) SSLSocketFactory.getDefault())
+                        .createSocket(plain, host, port, true);
+                candidate = ssl;
+                activeSocket.set(candidate);
+                SSLParameters parameters = ssl.getSSLParameters();
+                parameters.setEndpointIdentificationAlgorithm("HTTPS");
+                if (!isIpLiteral(host)) {
+                    parameters.setServerNames(List.of(new SNIHostName(host)));
+                }
+                ssl.setSSLParameters(parameters);
+                ssl.setSoTimeout(deadline.remainingMillis());
+                ssl.startHandshake();
+                ssl.setSoTimeout(deadline.remainingMillis());
+                return ssl;
+            } catch (IOException e) {
+                lastFailure = e;
+                closeQuietly(candidate);
+                if (candidate != plain) closeQuietly(plain);
+                activeSocket.compareAndSet(candidate, null);
+                if (deadline.isExpired()) {
+                    throw deadline.timeout("HTTP connection deadline exceeded", e);
+                }
+            }
+        }
+        throw new IOException("Unable to connect to validated HTTP target", lastFailure);
+    }
+
+    private static Thread startDeadlineWatchdog(Deadline deadline,
+                                                AtomicReference<Socket> activeSocket,
+                                                AtomicBoolean deadlineTriggered)
+            throws SocketTimeoutException {
+        long remainingNanos = deadline.remainingNanos();
+        return Thread.ofVirtual().name("pinned-http-deadline").start(() -> {
+            try {
+                TimeUnit.NANOSECONDS.sleep(remainingNanos);
+            } catch (InterruptedException ignored) {
+                return;
+            }
+            deadlineTriggered.set(true);
+            closeQuietly(activeSocket.get());
+        });
+    }
+
+    private static void closeQuietly(Socket socket) {
+        if (socket == null) return;
+        try {
+            socket.close();
+        } catch (IOException ignored) {}
+    }
+
+    private static void writeRequest(OutputStream output,
+                                     URI uri,
+                                     String host,
+                                     int port,
+                                     String scheme,
+                                     String method,
+                                     Map<String, String> requestHeaders,
+                                     byte[] requestBody) throws IOException {
+        String target = uri.getRawPath();
+        if (target == null || target.isEmpty()) target = "/";
+        if (uri.getRawQuery() != null) target += "?" + uri.getRawQuery();
+
+        StringBuilder request = new StringBuilder(512);
+        request.append(method).append(' ').append(target).append(" HTTP/1.1\r\n");
+        request.append("Host: ").append(hostHeader(host, port, scheme)).append("\r\n");
+        request.append("Connection: close\r\n");
+        request.append("Content-Length: ").append(requestBody.length).append("\r\n");
+        for (Map.Entry<String, String> header : requestHeaders.entrySet()) {
+            String name = header.getKey();
+            String value = header.getValue();
+            if (name == null || value == null || containsCrlf(name) || containsCrlf(value)) {
+                throw new IOException("Invalid HTTP request header");
+            }
+            if (name.equalsIgnoreCase("host")
+                    || name.equalsIgnoreCase("connection")
+                    || name.equalsIgnoreCase("content-length")) {
+                continue;
+            }
+            request.append(name).append(": ").append(value).append("\r\n");
+        }
+        request.append("\r\n");
+        output.write(request.toString().getBytes(StandardCharsets.ISO_8859_1));
+        output.write(requestBody);
+    }
+
+    private static ResponseHead readFinalResponseHead(InputStream input) throws IOException {
+        for (int interim = 0; interim <= MAX_INTERIM_RESPONSES; interim++) {
+            ResponseHead head = readResponseHead(input);
+            if (head.statusCode() < 100 || head.statusCode() >= 200) {
+                return head;
+            }
+        }
+        throw new IOException("Too many interim HTTP responses");
+    }
+
+    private static ResponseHead readResponseHead(InputStream input) throws IOException {
+        HeaderBudget budget = new HeaderBudget();
+        String statusLine = readLine(input, budget);
+        if (statusLine == null || !statusLine.startsWith("HTTP/1.")) {
+            throw new IOException("Invalid HTTP response status line");
+        }
+        String[] statusParts = statusLine.split(" ", 3);
+        if (statusParts.length < 2) {
+            throw new IOException("Invalid HTTP response status line");
+        }
+        int statusCode;
+        try {
+            statusCode = Integer.parseInt(statusParts[1]);
+        } catch (NumberFormatException e) {
+            throw new IOException("Invalid HTTP response status code", e);
+        }
+
+        Map<String, List<String>> headers = new LinkedHashMap<>();
+        while (true) {
+            String line = readLine(input, budget);
+            if (line == null) throw new EOFException("Unexpected EOF in HTTP headers");
+            if (line.isEmpty()) break;
+            if (Character.isWhitespace(line.charAt(0))) {
+                throw new IOException("Obsolete folded HTTP header rejected");
+            }
+            int colon = line.indexOf(':');
+            if (colon <= 0) throw new IOException("Malformed HTTP response header");
+            String name = line.substring(0, colon).trim().toLowerCase(Locale.ROOT);
+            String value = line.substring(colon + 1).trim();
+            headers.computeIfAbsent(name, ignored -> new ArrayList<>()).add(value);
+        }
+        return new ResponseHead(statusCode, headers);
+    }
+
+    private static byte[] readResponseBody(InputStream input,
+                                           Map<String, List<String>> headers,
+                                           int maxBytes) throws IOException {
+        String transferEncoding = firstHeader(headers, "transfer-encoding");
+        if (transferEncoding != null
+                && Arrays.stream(transferEncoding.split(","))
+                .anyMatch(value -> value.trim().equalsIgnoreCase("chunked"))) {
+            return readChunkedBody(input, maxBytes);
+        }
+
+        Long contentLength = parseContentLength(headers);
+        if (contentLength != null) {
+            if (contentLength > maxBytes) {
+                throw new ResponseTooLargeException(maxBytes);
+            }
+            return readExact(input, contentLength.intValue());
+        }
+        return readUntilEof(input, maxBytes);
+    }
+
+    private static byte[] readChunkedBody(InputStream input, int maxBytes) throws IOException {
+        ByteArrayOutputStream output = new ByteArrayOutputStream(Math.min(maxBytes, 16 * 1024));
+        HeaderBudget lineBudget = new HeaderBudget();
+        while (true) {
+            String sizeLine = readLine(input, lineBudget);
+            if (sizeLine == null) throw new EOFException("Unexpected EOF in chunked response");
+            int semicolon = sizeLine.indexOf(';');
+            String sizeText = (semicolon >= 0 ? sizeLine.substring(0, semicolon) : sizeLine).trim();
+            long chunkSize;
+            try {
+                chunkSize = Long.parseUnsignedLong(sizeText, 16);
+            } catch (NumberFormatException e) {
+                throw new IOException("Invalid HTTP chunk size", e);
+            }
+            if (chunkSize == 0) {
+                readTrailers(input);
+                return output.toByteArray();
+            }
+            if (chunkSize > maxBytes - (long) output.size()) {
+                throw new ResponseTooLargeException(maxBytes);
+            }
+            copyExact(input, output, chunkSize);
+            expectCrlf(input);
+        }
+    }
+
+    private static void readTrailers(InputStream input) throws IOException {
+        HeaderBudget budget = new HeaderBudget();
+        while (true) {
+            String line = readLine(input, budget);
+            if (line == null) throw new EOFException("Unexpected EOF in HTTP trailers");
+            if (line.isEmpty()) return;
+            if (line.indexOf(':') <= 0) throw new IOException("Malformed HTTP trailer");
+        }
+    }
+
+    private static byte[] readExact(InputStream input, int length) throws IOException {
+        ByteArrayOutputStream output = new ByteArrayOutputStream(length);
+        copyExact(input, output, length);
+        return output.toByteArray();
+    }
+
+    private static void copyExact(InputStream input, ByteArrayOutputStream output, long length)
+            throws IOException {
+        byte[] buffer = new byte[8192];
+        long remaining = length;
+        while (remaining > 0) {
+            int read = input.read(buffer, 0, (int) Math.min(buffer.length, remaining));
+            if (read < 0) throw new EOFException("Unexpected EOF in HTTP response body");
+            output.write(buffer, 0, read);
+            remaining -= read;
+        }
+    }
+
+    private static byte[] readUntilEof(InputStream input, int maxBytes) throws IOException {
+        ByteArrayOutputStream output = new ByteArrayOutputStream(Math.min(maxBytes, 16 * 1024));
+        byte[] buffer = new byte[8192];
+        int read;
+        while ((read = input.read(buffer)) >= 0) {
+            if (read == 0) continue;
+            if (read > maxBytes - output.size()) {
+                throw new ResponseTooLargeException(maxBytes);
+            }
+            output.write(buffer, 0, read);
+        }
+        return output.toByteArray();
+    }
+
+    private static Long parseContentLength(Map<String, List<String>> headers) throws IOException {
+        List<String> values = headers.get("content-length");
+        if (values == null || values.isEmpty()) return null;
+        Long expected = null;
+        for (String raw : values) {
+            for (String part : raw.split(",")) {
+                long parsed;
+                try {
+                    parsed = Long.parseLong(part.trim());
+                } catch (NumberFormatException e) {
+                    throw new IOException("Invalid Content-Length", e);
+                }
+                if (parsed < 0 || (expected != null && expected != parsed)) {
+                    throw new IOException("Conflicting Content-Length headers");
+                }
+                expected = parsed;
+            }
+        }
+        return expected;
+    }
+
+    private static void expectCrlf(InputStream input) throws IOException {
+        if (input.read() != '\r' || input.read() != '\n') {
+            throw new IOException("Malformed chunked HTTP response");
+        }
+    }
+
+    private static String readLine(InputStream input, HeaderBudget budget) throws IOException {
+        ByteArrayOutputStream line = new ByteArrayOutputStream(128);
+        int previous = -1;
+        while (true) {
+            int current = input.read();
+            if (current < 0) {
+                if (line.size() == 0 && previous < 0) return null;
+                throw new EOFException("Unexpected EOF in HTTP line");
+            }
+            budget.consumeByte();
+            if (previous == '\r' && current == '\n') {
+                budget.finishLine();
+                byte[] bytes = line.toByteArray();
+                return new String(bytes, 0, bytes.length - 1, StandardCharsets.ISO_8859_1);
+            }
+            line.write(current);
+            if (line.size() > MAX_LINE_BYTES) {
+                throw new IOException("HTTP response line too long");
+            }
+            previous = current;
+        }
+    }
+
+    private static boolean hasNoResponseBody(String method, int statusCode) {
+        return "HEAD".equalsIgnoreCase(method)
+                || (statusCode >= 100 && statusCode < 200)
+                || statusCode == 204
+                || statusCode == 304;
+    }
+
+    private static String firstHeader(Map<String, List<String>> headers, String name) {
+        List<String> values = headers.get(name);
+        return values == null || values.isEmpty() ? null : values.getFirst();
+    }
+
+    private static String normalizedScheme(URI uri) throws IOException {
+        if (uri == null || uri.getScheme() == null) throw new IOException("HTTP URI has no scheme");
+        String scheme = uri.getScheme().toLowerCase(Locale.ROOT);
+        if (!scheme.equals("http") && !scheme.equals("https")) {
+            throw new IOException("Unsupported HTTP scheme: " + scheme);
+        }
+        return scheme;
+    }
+
+    private static String normalizedHost(URI uri) throws IOException {
+        if (uri == null || uri.getHost() == null || uri.getHost().isBlank()) {
+            throw new IOException("HTTP URI has no hostname");
+        }
+        if (uri.getUserInfo() != null || uri.getFragment() != null) {
+            throw new IOException("HTTP URI contains forbidden components");
+        }
+        String host = uri.getHost();
+        if (host.startsWith("[") && host.endsWith("]")) {
+            host = host.substring(1, host.length() - 1);
+        }
+        if (isIpLiteral(host)) return host;
+        try {
+            return IDN.toASCII(host, IDN.USE_STD3_ASCII_RULES).toLowerCase(Locale.ROOT);
+        } catch (IllegalArgumentException e) {
+            throw new IOException("Invalid HTTP hostname", e);
+        }
+    }
+
+    private static int effectivePort(URI uri, String scheme) throws IOException {
+        int port = uri.getPort();
+        if (port == -1) return "https".equals(scheme) ? 443 : 80;
+        if (port < 1 || port > 65535) throw new IOException("Invalid HTTP port");
+        return port;
+    }
+
+    private static String hostHeader(String host, int port, String scheme) {
+        String formattedHost = host.contains(":") ? "[" + host + "]" : host;
+        boolean defaultPort = ("http".equals(scheme) && port == 80)
+                || ("https".equals(scheme) && port == 443);
+        return defaultPort ? formattedHost : formattedHost + ":" + port;
+    }
+
+    private static boolean isIpLiteral(String host) {
+        if (host.indexOf(':') >= 0) return true;
+        String[] parts = host.split("\\.", -1);
+        if (parts.length != 4) return false;
+        for (String part : parts) {
+            try {
+                int value = Integer.parseInt(part);
+                if (value < 0 || value > 255) return false;
+            } catch (NumberFormatException e) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static int timeoutMillis(Duration timeout) {
+        if (timeout == null || timeout.isZero() || timeout.isNegative()) {
+            throw new IllegalArgumentException("HTTP timeout must be positive");
+        }
+        return (int) Math.min(Integer.MAX_VALUE, Math.max(1L, timeout.toMillis()));
+    }
+
+    private static boolean containsCrlf(String value) {
+        return value.indexOf('\r') >= 0 || value.indexOf('\n') >= 0;
+    }
+
+    private static final class Deadline {
+        private final long deadlineNanos;
+
+        private Deadline(long deadlineNanos) {
+            this.deadlineNanos = deadlineNanos;
+        }
+
+        static Deadline start(Duration timeout) {
+            int timeoutMillis = timeoutMillis(timeout);
+            return new Deadline(System.nanoTime()
+                    + TimeUnit.MILLISECONDS.toNanos(timeoutMillis));
+        }
+
+        int remainingMillis() throws SocketTimeoutException {
+            long nanos = remainingNanos();
+            return (int) Math.min(Integer.MAX_VALUE,
+                    Math.max(1L, TimeUnit.NANOSECONDS.toMillis(nanos)));
+        }
+
+        long remainingNanos() throws SocketTimeoutException {
+            long remaining = deadlineNanos - System.nanoTime();
+            if (remaining <= 0) {
+                throw timeout("HTTP request deadline exceeded", null);
+            }
+            return remaining;
+        }
+
+        boolean isExpired() {
+            return deadlineNanos - System.nanoTime() <= 0;
+        }
+
+        SocketTimeoutException timeout(String message, Throwable cause) {
+            SocketTimeoutException timeoutException = new SocketTimeoutException(message);
+            if (cause != null) timeoutException.initCause(cause);
+            return timeoutException;
+        }
+    }
+
+    private record ResponseHead(int statusCode, Map<String, List<String>> headers) {}
+
+    private static final class HeaderBudget {
+        private int bytes;
+        private int lines;
+
+        private void consumeByte() throws IOException {
+            if (++bytes > MAX_RESPONSE_HEADER_BYTES) {
+                throw new IOException("HTTP response headers too large");
+            }
+        }
+
+        private void finishLine() throws IOException {
+            if (++lines > MAX_RESPONSE_HEADER_LINES) {
+                throw new IOException("Too many HTTP response header lines");
+            }
+        }
+    }
+
+    public static final class ResponseTooLargeException extends IOException {
+        public ResponseTooLargeException(int maxBytes) {
+            super("HTTP response exceeds " + maxBytes + " byte limit");
+        }
+    }
+}
