+package net.lmyz.lmyzmail.netty.honeypot.channel;
+
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import net.lmyz.lmyzmail.netty.honeypot.HoneypotProperties;
+import net.lmyz.lmyzmail.netty.honeypot.protocol.HoneypotProtocol;
+import net.lmyz.lmyzmail.netty.honeypot.protocol.VncMockeryHandler;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.atomic.AtomicInteger;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class HoneypotConnectionHandlerTest {
+
+    @Test
+    void rejectedConnectionReleasesCounterExactlyOnce() {
+        HoneypotProperties properties = new HoneypotProperties();
+        properties.setMaxConnectionsPerTrap(0);
+        properties.setInitialDelayMs(60_000);
+
+        HoneypotProperties.TrapDefinition trap = new HoneypotProperties.TrapDefinition();
+        trap.setLabel("test");
+        trap.setPort(1234);
+        trap.setServerProtocol(HoneypotProtocol.NONE);
+
+        AtomicInteger counter = new AtomicInteger();
+        EmbeddedChannel channel = new EmbeddedChannel(
+                new HoneypotConnectionHandler(properties, trap, null, counter));
+        channel.runPendingTasks();
+
+        assertThat(channel.isOpen()).isFalse();
+        assertThat(counter).hasValue(0);
+        channel.finishAndReleaseAll();
+    }
+
+    @Test
+    void vncHandoffKeepsConnectionSlotUntilChannelCloses() {
+        HoneypotProperties properties = new HoneypotProperties();
+        properties.setMaxConnectionsPerTrap(1);
+        properties.setInitialDelayMs(60_000);
+
+        HoneypotProperties.TrapDefinition trap = new HoneypotProperties.TrapDefinition();
+        trap.setLabel("test-vnc");
+        trap.setPort(5900);
+        trap.setServerProtocol(HoneypotProtocol.NONE);
+
+        AtomicInteger counter = new AtomicInteger();
+        EmbeddedChannel channel = new EmbeddedChannel(
+                new HoneypotConnectionHandler(properties, trap, null, counter));
+
+        try {
+            assertThat(counter).hasValue(1);
+
+            channel.writeInbound(Unpooled.copiedBuffer(
+                    "RFB 003.008\n", StandardCharsets.US_ASCII));
+            channel.runPendingTasks();
+
+            assertThat(channel.pipeline().get(HoneypotConnectionHandler.class)).isNull();
+            assertThat(channel.pipeline().get(VncMockeryHandler.class)).isNotNull();
+            assertThat(counter).hasValue(1);
+
+            channel.close().syncUninterruptibly();
+            channel.runPendingTasks();
+            assertThat(counter).hasValue(0);
+        } finally {
+            channel.finishAndReleaseAll();
+        }
+
+        assertThat(counter).hasValue(0);
+    }
+}
