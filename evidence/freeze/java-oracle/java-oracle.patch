+import java.util.concurrent.ThreadPoolExecutor;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class BotmailApplicationSecurityTest {
+
+    @Test
+    void dnsExecutorHasFiniteWorkerAndQueueLimits() {
+        Executor executor = new BotmailApplication().dnsQueryExecutor();
+        assertThat(executor).isInstanceOf(ThreadPoolExecutor.class);
+
+        ThreadPoolExecutor pool = (ThreadPoolExecutor) executor;
+        try {
+            assertThat(pool.getMaximumPoolSize()).isLessThanOrEqualTo(64);
+            assertThat(pool.getQueue().remainingCapacity()).isBetween(1, 4096);
+        } finally {
+            pool.shutdownNow();
+        }
+    }
+}
