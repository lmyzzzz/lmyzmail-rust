+package net.lmyz.lmyzmail.web;
+
+import io.github.bucket4j.Bucket;
+import net.lmyz.lmyzmail.config.BotmailProperties;
+import net.lmyz.lmyzmail.config.RateLimitProperties;
+import net.lmyz.lmyzmail.config.RequireApiPermission;
