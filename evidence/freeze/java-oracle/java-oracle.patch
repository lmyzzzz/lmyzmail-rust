+package net.lmyz.lmyzmail.netty.minecraft.gui;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.net.URI;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class MailViewManagerSecurityTest {
+
+    @Test
+    void rejectsPrivateIpv4AndIpv6ImageTargets() {
+        assertThatThrownBy(() -> MailViewManager.downloadExternalImage(
+                URI.create("http://127.0.0.1/a.png")))
+                .isInstanceOf(SecurityException.class);
+        assertThatThrownBy(() -> MailViewManager.downloadExternalImage(
+                URI.create("http://169.254.169.254/a.png")))
+                .isInstanceOf(SecurityException.class);
+        assertThatThrownBy(() -> MailViewManager.downloadExternalImage(
+                URI.create("http://[::1]/a.png")))
+                .isInstanceOf(SecurityException.class);
+        assertThatThrownBy(() -> MailViewManager.downloadExternalImage(
+                URI.create("http://[fe80::1]/a.png")))
+                .isInstanceOf(SecurityException.class);
+    }
+
+    @Test
+    void acceptsOnlyHttpSchemesAndDefaultPorts() {
+        assertThat(MailViewManager.isAllowedImageUri(URI.create("file:///etc/passwd")))
+                .isFalse();
+        assertThat(MailViewManager.isAllowedImageUri(URI.create("http://8.8.8.8:22/a.png")))
+                .isFalse();
+        assertThat(MailViewManager.isAllowedImageUri(URI.create("https://8.8.8.8/a.png")))
+                .isTrue();
+    }
+
+    @Test
+    void externalImagesRejectActiveSvgContent() {
+        assertThat(MailViewManager.isSafeExternalImageContentType("image/png")).isTrue();
+        assertThat(MailViewManager.isSafeExternalImageContentType("image/svg+xml")).isFalse();
+    }
+
+    @Test
+    void boundedReaderStopsBeforeBufferingOversizedResponse() {
+        byte[] oversized = new byte[1025];
+        var stream = new ByteArrayInputStream(oversized);
+
+        assertThatThrownBy(() -> MailViewManager.readAtMost(stream, 1024))
+                .isInstanceOf(IOException.class)
+                .hasMessageContaining("exceeds");
+    }
+
+    @Test
+    void boundedReaderReturnsBodyWithinLimit() throws Exception {
+        byte[] body = new byte[1024];
+        assertThat(MailViewManager.readAtMost(new ByteArrayInputStream(body), 1024))
+                .containsExactly(body);
+    }
+}
diff --git a/src/test/java/net/lmyz/lmyzmail/netty/minecraft/nbt/NbtIoLimitsTest.java b/src/test/java/net/lmyz/lmyzmail/netty/minecraft/nbt/NbtIoLimitsTest.java
new file mode 100644
index 0000000..cc7f631
--- /dev/null
+++ b/src/test/java/net/lmyz/lmyzmail/netty/minecraft/nbt/NbtIoLimitsTest.java
@@ -0,0 +1,73 @@
+package net.lmyz.lmyzmail.netty.minecraft.nbt;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.ByteArrayOutputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class NbtIoLimitsTest {
+
+    @Test
+    void rejectsNegativeArrayLengthWithoutAllocating() throws Exception {
+        byte[] nbt = rootWithTag(out -> {
+            out.writeByte(NbtTag.TAG_BYTE_ARRAY);
+            out.writeUTF("bytes");
+            out.writeInt(-1);
+        });
+
+        assertThatThrownBy(() -> NbtIo.readFromBytes(nbt))
+                .isInstanceOf(IOException.class)
+                .hasMessageContaining("length");
+    }
+
+    @Test
+    void rejectsCollectionLengthAboveBudgetBeforeAllocating() throws Exception {
+        byte[] nbt = rootWithTag(out -> {
+            out.writeByte(NbtTag.TAG_LIST);
+            out.writeUTF("items");
+            out.writeByte(NbtTag.TAG_BYTE);
+            out.writeInt(NbtIo.MAX_COLLECTION_LENGTH + 1);
+        });
+
+        assertThatThrownBy(() -> NbtIo.readFromBytes(nbt))
+                .isInstanceOf(IOException.class)
+                .hasMessageContaining("collection length");
+    }
+
+    @Test
+    void rejectsExcessiveNestingDepth() throws Exception {
+        var bytes = new ByteArrayOutputStream();
+        var out = new DataOutputStream(bytes);
+        out.writeByte(NbtTag.TAG_COMPOUND);
+        out.writeUTF("");
+        for (int i = 0; i <= NbtIo.MAX_DEPTH; i++) {
+            out.writeByte(NbtTag.TAG_COMPOUND);
+            out.writeUTF("n");
+        }
+        for (int i = 0; i <= NbtIo.MAX_DEPTH + 1; i++) {
+            out.writeByte(NbtTag.TAG_END);
+        }
+
+        assertThatThrownBy(() -> NbtIo.readFromBytes(bytes.toByteArray()))
+                .isInstanceOf(IOException.class)
+                .hasMessageContaining("depth");
+    }
+
+    private static byte[] rootWithTag(IoWriter writer) throws Exception {
+        var bytes = new ByteArrayOutputStream();
+        var out = new DataOutputStream(bytes);
+        out.writeByte(NbtTag.TAG_COMPOUND);
+        out.writeUTF("");
+        writer.write(out);
+        out.writeByte(NbtTag.TAG_END);
+        return bytes.toByteArray();
+    }
+
+    @FunctionalInterface
+    private interface IoWriter {
+        void write(DataOutputStream out) throws Exception;
+    }
+}
