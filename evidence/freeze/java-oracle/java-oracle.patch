diff --git a/src/test/java/net/lmyz/lmyzmail/util/PinnedHttpClientSecurityTest.java b/src/test/java/net/lmyz/lmyzmail/util/PinnedHttpClientSecurityTest.java
new file mode 100644
index 0000000..cc438c1
--- /dev/null
+++ b/src/test/java/net/lmyz/lmyzmail/util/PinnedHttpClientSecurityTest.java
@@ -0,0 +1,189 @@
+package net.lmyz.lmyzmail.util;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.net.SocketTimeoutException;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.Map;
+import java.util.concurrent.ArrayBlockingQueue;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class PinnedHttpClientSecurityTest {
+
+    @Test
+    void connectsToValidatedIpWithoutResolvingTheUriHostnameAgain() throws Exception {
+        InetAddress loopback = InetAddress.getLoopbackAddress();
+        try (ServerSocket server = new ServerSocket(0, 1, loopback)) {
+            CompletableFuture<String> hostHeader = serveOnce(server,
+                    "HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: 2\r\n\r\nok");
+            URI uri = URI.create("http://does-not-resolve.invalid:"
+                    + server.getLocalPort() + "/image.png");
+
+            PinnedHttpClient.Response response = PinnedHttpClient.executePinned(
+                    uri, new InetAddress[]{loopback}, "GET", Map.of(),
+                    new byte[0], Duration.ofSeconds(2), 16);
+
+            assertThat(response.statusCode()).isEqualTo(200);
+            assertThat(response.body()).containsExactly((byte) 'o', (byte) 'k');
+            assertThat(hostHeader.get(2, TimeUnit.SECONDS))
+                    .isEqualTo("does-not-resolve.invalid:" + server.getLocalPort());
+        }
+    }
+
+    @Test
+    void returnsRedirectWithoutFollowingItsLocation() throws Exception {
+        InetAddress loopback = InetAddress.getLoopbackAddress();
+        try (ServerSocket server = new ServerSocket(0, 1, loopback)) {
+            serveOnce(server, "HTTP/1.1 302 Found\r\n"
+                    + "Location: http://127.0.0.1/internal\r\n"
+                    + "Content-Length: 0\r\n\r\n");
+            URI uri = URI.create("http://redirect.invalid:"
+                    + server.getLocalPort() + "/report");
+
+            PinnedHttpClient.Response response = PinnedHttpClient.executePinned(
+                    uri, new InetAddress[]{loopback}, "POST",
+                    Map.of("Content-Type", "application/test"), new byte[]{1},
+                    Duration.ofSeconds(2), 0);
+
+            assertThat(response.statusCode()).isEqualTo(302);
+        }
+    }
+
+    @Test
+    void rejectsChunkedBodiesBeforeTheyExceedTheConfiguredBudget() throws Exception {
+        InetAddress loopback = InetAddress.getLoopbackAddress();
+        try (ServerSocket server = new ServerSocket(0, 1, loopback)) {
+            serveOnce(server, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n"
+                    + "5\r\nabcde\r\n0\r\n\r\n");
+            URI uri = URI.create("http://bounded.invalid:"
+                    + server.getLocalPort() + "/body");
+
+            assertThatThrownBy(() -> PinnedHttpClient.executePinned(
+                    uri, new InetAddress[]{loopback}, "GET", Map.of(),
+                    new byte[0], Duration.ofSeconds(2), 4))
+                    .isInstanceOf(PinnedHttpClient.ResponseTooLargeException.class);
+        }
+    }
+
+    @Test
+    void absoluteDeadlineCannotBeExtendedBySlowResponseBytes() throws Exception {
+        InetAddress loopback = InetAddress.getLoopbackAddress();
+        try (ServerSocket server = new ServerSocket(0, 1, loopback)) {
+            CompletableFuture<Boolean> clientClosed = serveSlowResponse(server);
+            URI uri = URI.create("http://slow.invalid:"
+                    + server.getLocalPort() + "/slow");
+            long startedAt = System.nanoTime();
+
+            assertThatThrownBy(() -> PinnedHttpClient.executePinned(
+                    uri, new InetAddress[]{loopback}, "GET", Map.of(),
+                    new byte[0], Duration.ofMillis(250), 16))
+                    .isInstanceOf(SocketTimeoutException.class)
+                    .hasMessageContaining("deadline");
+
+            long elapsedMillis = TimeUnit.NANOSECONDS.toMillis(
+                    System.nanoTime() - startedAt);
+            assertThat(elapsedMillis).isLessThan(1_500);
+            assertThat(clientClosed.get(2, TimeUnit.SECONDS)).isTrue();
+        }
+    }
+
+    @Test
+    void cancelledDnsTasksAreRemovedFromTheBoundedQueue() throws Exception {
+        CountDownLatch workerStarted = new CountDownLatch(1);
+        CountDownLatch releaseWorker = new CountDownLatch(1);
+        AtomicBoolean queuedTaskRan = new AtomicBoolean();
+        ThreadPoolExecutor executor = new ThreadPoolExecutor(
+                1, 1, 0L, TimeUnit.MILLISECONDS, new ArrayBlockingQueue<>(1));
+        try {
+            executor.submit(() -> {
+                workerStarted.countDown();
+                try {
+                    releaseWorker.await();
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                }
+            });
+            assertThat(workerStarted.await(1, TimeUnit.SECONDS)).isTrue();
+
+            var queuedResolution = executor.submit(() -> queuedTaskRan.set(true));
+            assertThat(executor.getQueue()).hasSize(1);
+
+            PinnedHttpClient.cancelDnsResolution(queuedResolution, executor);
+
+            assertThat(queuedResolution.isCancelled()).isTrue();
+            assertThat(executor.getQueue()).isEmpty();
+            assertThat(queuedTaskRan).isFalse();
+        } finally {
+            releaseWorker.countDown();
+            executor.shutdownNow();
+            assertThat(executor.awaitTermination(1, TimeUnit.SECONDS)).isTrue();
+        }
+    }
+
+    private static CompletableFuture<String> serveOnce(ServerSocket server, String response) {
+        CompletableFuture<String> hostHeader = new CompletableFuture<>();
+        Thread.ofVirtual().start(() -> {
+            try (var socket = server.accept();
+                 var reader = new BufferedReader(new InputStreamReader(
+                         socket.getInputStream(), StandardCharsets.ISO_8859_1))) {
+                String host = null;
+                String line;
+                while ((line = reader.readLine()) != null && !line.isEmpty()) {
+                    if (line.regionMatches(true, 0, "Host:", 0, 5)) {
+                        host = line.substring(5).trim();
+                    }
+                }
+                socket.getOutputStream().write(
+                        response.getBytes(StandardCharsets.ISO_8859_1));
+                socket.getOutputStream().flush();
+                hostHeader.complete(host);
+            } catch (Throwable error) {
+                hostHeader.completeExceptionally(error);
+            }
+        });
+        return hostHeader;
+    }
+
+    private static CompletableFuture<Boolean> serveSlowResponse(ServerSocket server) {
+        CompletableFuture<Boolean> clientClosed = new CompletableFuture<>();
+        Thread.ofVirtual().start(() -> {
+            try (var socket = server.accept();
+                 var reader = new BufferedReader(new InputStreamReader(
+                         socket.getInputStream(), StandardCharsets.ISO_8859_1))) {
+                String line;
+                while ((line = reader.readLine()) != null && !line.isEmpty()) {
+                    // Consume the complete request before beginning the slow response.
+                }
+                byte[] response = ("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+                        .getBytes(StandardCharsets.ISO_8859_1);
+                for (byte value : response) {
+                    socket.getOutputStream().write(value);
+                    socket.getOutputStream().flush();
+                    Thread.sleep(100);
+                }
+                clientClosed.complete(false);
+            } catch (java.io.IOException e) {
+                clientClosed.complete(true);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                clientClosed.completeExceptionally(e);
+            } catch (Throwable error) {
+                clientClosed.completeExceptionally(error);
+            }
+        });
+        return clientClosed;
+    }
+}
