+package net.lmyz.lmyzmail.mailbox.api;
+
+import net.lmyz.lmyzmail.netty.http.handler.NettyHttpRequest;
+import net.lmyz.lmyzmail.netty.http.handler.NettyHttpResponse;
+import net.lmyz.lmyzmail.outbound.OutboundMailService;
+import net.lmyz.lmyzmail.outbound.Recipients;
+import net.lmyz.lmyzmail.ratelimit.RateLimitService;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.test.context.bean.override.mockito.MockitoBean;
+import org.springframework.test.context.junit.jupiter.SpringJUnitConfig;
+
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyList;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.nullable;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@SpringJUnitConfig(MailSendController.class)
+class MailSendControllerSecurityTest {
+
+    private static final String ADDRESS = "alice@example.test";
+    private static final String PASSWORD = "password";
+    private static final String CLIENT_IP = "203.0.113.25";
+
+    @Autowired
+    private MailSendController controller;
+
+    @MockitoBean
+    private OutboundMailService outboundMailService;
+
+    @MockitoBean
+    private RateLimitService rateLimitService;
+
+    @Test
+    void asynchronousAuthenticationFailureConsumesLoginFailureBudget() {
+        when(outboundMailService.queueMail(
+                anyString(), anyString(), any(Recipients.class), anyString(),
+                anyString(), nullable(String.class), anyList()))
+                .thenReturn(OutboundMailService.QueueResult.failure("Invalid credentials"));
+        NettyHttpRequest httpRequest = requestFromClientIp();
+
+        NettyHttpResponse response = controller.send(sendRequest(true), httpRequest);
+
+        assertThat(response.status()).isEqualTo(401);
+        verify(rateLimitService).recordFailedLogin(CLIENT_IP, ADDRESS);
+        verify(rateLimitService, never()).clearFailedLogins(CLIENT_IP, ADDRESS);
+    }
+
+    @Test
+    void asynchronousSuccessClearsOnlyTheMatchingPrincipalBucket() {
+        when(outboundMailService.queueMail(
+                anyString(), anyString(), any(Recipients.class), anyString(),
+                anyString(), nullable(String.class), anyList()))
+                .thenReturn(OutboundMailService.QueueResult.success(
+                        7L, "<message@example.test>", "sent.eml", null));
+        NettyHttpRequest httpRequest = requestFromClientIp();
+
+        NettyHttpResponse response = controller.send(sendRequest(true), httpRequest);
+
+        assertThat(response.status()).isEqualTo(202);
+        verify(rateLimitService).clearFailedLogins(CLIENT_IP, ADDRESS);
+        verify(rateLimitService, never()).clearFailedLogins(CLIENT_IP);
+        verify(rateLimitService, never()).recordFailedLogin(CLIENT_IP, ADDRESS);
+    }
+
+    @Test
+    void synchronousSuccessAlsoClearsOnlyTheMatchingPrincipalBucket() {
+        when(outboundMailService.sendMail(
+                anyString(), anyString(), any(Recipients.class), anyString(),
+                anyString(), nullable(String.class), anyList()))
+                .thenReturn(new OutboundMailService.SendResult(
+                        true, "<message@example.test>", null));
+        NettyHttpRequest httpRequest = requestFromClientIp();
+
+        NettyHttpResponse response = controller.send(sendRequest(false), httpRequest);
+
+        assertThat(response.status()).isEqualTo(200);
+        verify(rateLimitService).clearFailedLogins(CLIENT_IP, ADDRESS);
+        verify(rateLimitService, never()).clearFailedLogins(CLIENT_IP);
+    }
+
+    @Test
+    void synchronousAuthenticationFailureConsumesLoginFailureBudget() {
+        when(outboundMailService.sendMail(
+                anyString(), anyString(), any(Recipients.class), anyString(),
+                anyString(), nullable(String.class), anyList()))
+                .thenReturn(new OutboundMailService.SendResult(
+                        false, null, "Invalid credentials"));
+        NettyHttpRequest httpRequest = requestFromClientIp();
+
+        NettyHttpResponse response = controller.send(sendRequest(false), httpRequest);
+
+        assertThat(response.status()).isEqualTo(401);
+        verify(rateLimitService).recordFailedLogin(CLIENT_IP, ADDRESS);
+        verify(rateLimitService, never()).clearFailedLogins(CLIENT_IP, ADDRESS);
+    }
+
+    private static SendMailRequest sendRequest(boolean async) {
+        return new SendMailRequest(
+                ADDRESS,
+                PASSWORD,
+                List.of("bob@example.test"),
+                List.of(),
+                List.of(),
+                "subject",
+                "body",
+                null,
+                List.of(),
+                null,
+                null,
+                async
+        );
+    }
+
+    private static NettyHttpRequest requestFromClientIp() {
+        NettyHttpRequest request = mock(NettyHttpRequest.class);
+        when(request.remoteAddress()).thenReturn(CLIENT_IP);
+        return request;
+    }
+}
