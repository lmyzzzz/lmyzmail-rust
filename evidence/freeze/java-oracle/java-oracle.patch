+package net.lmyz.lmyzmail.netty.minecraft.protocol;
+
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.handler.codec.CorruptedFrameException;
+import io.netty.handler.codec.DecoderException;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+class MinecraftProtocolLimitsTest {
+
+    @Test
+    void byteArrayRejectsNegativeLengthAsProtocolError() {
+        var buf = Unpooled.buffer();
+        PacketBuf.writeVarInt(buf, -1);
+        try {
+            assertThatThrownBy(() -> PacketBuf.readByteArray(buf))
+                    .isInstanceOf(DecoderException.class)
+                    .hasMessageContaining("length");
+        } finally {
+            buf.release();
+        }
+    }
+
+    @Test
+    void byteArrayRejectsLengthAboveFieldBudgetBeforeAllocation() {
+        var buf = Unpooled.buffer();
+        PacketBuf.writeVarInt(buf, 4096);
+        try {
+            assertThatThrownBy(() -> PacketBuf.readByteArray(buf, 256))
+                    .isInstanceOf(DecoderException.class)
+                    .hasMessageContaining("4096")
+                    .hasMessageContaining("256");
+        } finally {
+            buf.release();
+        }
+    }
+
+    @Test
+    void frameCodecRejectsDeclaredFrameAboveGlobalBudgetImmediately() {
+        EmbeddedChannel channel = new EmbeddedChannel(new VarIntFrameCodec());
+        var header = Unpooled.buffer();
+        PacketBuf.writeVarInt(header, VarIntFrameCodec.MAX_FRAME_LENGTH + 1);
+
+        assertThatThrownBy(() -> channel.writeInbound(header))
+                .isInstanceOf(CorruptedFrameException.class)
+                .hasMessageContaining("frame length");
+    }
+}
