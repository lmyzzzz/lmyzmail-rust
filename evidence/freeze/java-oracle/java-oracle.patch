+
+    static URI validateTlsReportEndpoint(String endpoint) throws Exception {
+        URI uri = URI.create(endpoint);
+        if (!"https".equalsIgnoreCase(uri.getScheme())) {
+            throw new SecurityException("TLS report endpoint must use HTTPS");
+        }
+        if (uri.getHost() == null || uri.getHost().isBlank()) {
+            throw new SecurityException("TLS report endpoint must contain a hostname");
+        }
+        if (uri.getUserInfo() != null || uri.getFragment() != null) {
+            throw new SecurityException("TLS report endpoint contains forbidden URI components");
+        }
+        if (uri.getPort() != -1 && uri.getPort() != 443) {
+            throw new SecurityException("TLS report endpoint must use port 443");
+        }
+
+        return uri;
+    }
+}
