+package net.lmyz.lmyzmail.ratelimit;
+
+import net.lmyz.lmyzmail.config.RateLimitProperties;
+import net.lmyz.lmyzmail.inbound.MailStoreProperties;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class RateLimitServiceLoginSecurityTest {
+
+    @Test
+    void successfulLoginForAnotherAccountDoesNotResetIpFailureBudget() {
+        RateLimitProperties properties = new RateLimitProperties();
+        properties.setMaxFailedLoginAttempts(2);
+        properties.setFailedLoginWindowMinutes(5);
+        RateLimitService service = new RateLimitService(properties, new MailStoreProperties());
+
+        String ip = "203.0.113.50";
+        assertThat(service.recordFailedLogin(ip, "victim@example.test")).isFalse();
+
+        service.clearFailedLogins(ip, "attacker@example.test");
+
+        assertThat(service.recordFailedLogin(ip, "victim@example.test")).isFalse();
+        assertThat(service.recordFailedLogin(ip, "victim@example.test")).isTrue();
+        assertThat(service.isIpBanned(ip)).isTrue();
+    }
+
+    @Test
+    void successfulLoginOnlyClearsTheMatchingPrincipalBucket() {
+        RateLimitProperties properties = new RateLimitProperties();
+        properties.setMaxFailedLoginAttempts(2);
+        RateLimitService service = new RateLimitService(properties, new MailStoreProperties());
+
+        String ip = "198.51.100.25";
+        assertThat(service.recordFailedLogin(ip, "first@example.test")).isFalse();
+        service.clearFailedLogins(ip, "first@example.test");
+
+        // The IP-wide budget still contains the first failure. A different account
+        // therefore cannot use the successful login as a global reset primitive.
+        assertThat(service.recordFailedLogin(ip, "second@example.test")).isFalse();
+        assertThat(service.recordFailedLogin(ip, "second@example.test")).isTrue();
+    }
+}
