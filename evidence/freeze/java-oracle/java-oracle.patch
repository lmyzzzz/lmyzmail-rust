+package net.lmyz.lmyzmail.netty.http.handler;
+
+import io.netty.buffer.Unpooled;
+import io.netty.handler.codec.http.DefaultFullHttpRequest;
+import io.netty.handler.codec.http.HttpMethod;
+import io.netty.handler.codec.http.HttpVersion;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import java.net.InetSocketAddress;
+import java.util.Set;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class NettyHttpRequestProxyTest {
+
+    @AfterEach
+    void restoreDefaultTrustedProxies() {
+        NettyHttpRequest.setTrustedProxies(null);
+    }
+
+    @Test
+    void ignoresAttackerSuppliedLeftmostAddressWhenTrustedProxyAppendsPeer() {
+        NettyHttpRequest.setTrustedProxies(Set.of("127.0.0.1"));
+        var raw = new DefaultFullHttpRequest(
+                HttpVersion.HTTP_1_1, HttpMethod.GET, "/", Unpooled.EMPTY_BUFFER);
+        raw.headers().set("X-Forwarded-For", "198.51.100.10, 203.0.113.25");
+
+        var request = new NettyHttpRequest(raw,
+                new InetSocketAddress("127.0.0.1", 12345));
+
+        assertThat(request.remoteAddress()).isEqualTo("203.0.113.25");
+        raw.release();
+    }
+
+    @Test
+    void stripsTrustedProxyHopsFromRightHandSide() {
+        NettyHttpRequest.setTrustedProxies(Set.of("127.0.0.1", "10.0.0.0/8"));
+        var raw = new DefaultFullHttpRequest(
+                HttpVersion.HTTP_1_1, HttpMethod.GET, "/", Unpooled.EMPTY_BUFFER);
+        raw.headers().set("X-Forwarded-For", "203.0.113.25, 10.2.3.4");
+
+        var request = new NettyHttpRequest(raw,
+                new InetSocketAddress("127.0.0.1", 12345));
+
+        assertThat(request.remoteAddress()).isEqualTo("203.0.113.25");
+        raw.release();
+    }
+
+    @Test
+    void rejectsNonIpForwardedValues() {
+        NettyHttpRequest.setTrustedProxies(Set.of("127.0.0.1"));
+        var raw = new DefaultFullHttpRequest(
+                HttpVersion.HTTP_1_1, HttpMethod.GET, "/", Unpooled.EMPTY_BUFFER);
+        raw.headers().set("X-Forwarded-For", "spoofed.example, 203.0.113.25");
+
+        var request = new NettyHttpRequest(raw,
+                new InetSocketAddress("127.0.0.1", 12345));
+
+        assertThat(request.remoteAddress()).isEqualTo("203.0.113.25");
+        raw.release();
+    }
+
+    @Test
+    void combinesRepeatedForwardedForHeadersInWireOrder() {
+        NettyHttpRequest.setTrustedProxies(Set.of("127.0.0.1", "10.0.0.0/8"));
+        var raw = new DefaultFullHttpRequest(
+                HttpVersion.HTTP_1_1, HttpMethod.GET, "/", Unpooled.EMPTY_BUFFER);
+        raw.headers().add("X-Forwarded-For", "198.51.100.10");
+        raw.headers().add("X-Forwarded-For", "203.0.113.25, 10.2.3.4");
+
+        var request = new NettyHttpRequest(raw,
+                new InetSocketAddress("127.0.0.1", 12345));
+
+        assertThat(request.remoteAddress()).isEqualTo("203.0.113.25");
+        raw.release();
+    }
+
+    @Test
+    void doesNotFallBackToRealIpWhenForwardedForHeaderIsPresent() {
+        NettyHttpRequest.setTrustedProxies(Set.of("127.0.0.1", "10.0.0.0/8"));
+        var raw = new DefaultFullHttpRequest(
+                HttpVersion.HTTP_1_1, HttpMethod.GET, "/", Unpooled.EMPTY_BUFFER);
+        raw.headers().set("X-Forwarded-For", "10.2.3.4");
+        raw.headers().set("X-Real-IP", "198.51.100.10");
+
+        var request = new NettyHttpRequest(raw,
+                new InetSocketAddress("127.0.0.1", 12345));
+
+        assertThat(request.remoteAddress()).isEqualTo("127.0.0.1");
+        raw.release();
+    }
+
+    @Test
+    void ambiguousRightHandForwardedHopFallsBackToSocketPeer() {
+        NettyHttpRequest.setTrustedProxies(Set.of("127.0.0.1"));
+        var raw = new DefaultFullHttpRequest(
+                HttpVersion.HTTP_1_1, HttpMethod.GET, "/", Unpooled.EMPTY_BUFFER);
+        raw.headers().set("X-Forwarded-For", "203.0.113.25, not-an-ip");
+        raw.headers().set("X-Real-IP", "198.51.100.10");
+
+        var request = new NettyHttpRequest(raw,
+                new InetSocketAddress("127.0.0.1", 12345));
+
+        assertThat(request.remoteAddress()).isEqualTo("127.0.0.1");
+        raw.release();
+    }
+}
diff --git a/src/test/java/net/lmyz/lmyzmail/netty/http/server/HttpRequestSizeGuardTest.java b/src/test/java/net/lmyz/lmyzmail/netty/http/server/HttpRequestSizeGuardTest.java
new file mode 100644
index 0000000..419f65e
--- /dev/null
+++ b/src/test/java/net/lmyz/lmyzmail/netty/http/server/HttpRequestSizeGuardTest.java
@@ -0,0 +1,313 @@
+package net.lmyz.lmyzmail.netty.http.server;
+
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import io.netty.handler.codec.http.DefaultHttpContent;
+import io.netty.handler.codec.http.DefaultHttpRequest;
+import io.netty.handler.codec.http.FullHttpResponse;
+import io.netty.handler.codec.http.HttpHeaderNames;
+import io.netty.handler.codec.http.HttpMethod;
+import io.netty.handler.codec.http.HttpResponseStatus;
+import io.netty.handler.codec.http.HttpVersion;
+import io.netty.handler.codec.http.LastHttpContent;
+import net.lmyz.lmyzmail.netty.http.routing.RouteRegistry;
+import org.junit.jupiter.api.Test;
+
+import java.util.List;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.ThreadPoolExecutor;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicBoolean;
+import java.util.concurrent.atomic.AtomicReference;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class HttpRequestSizeGuardTest {
+
+    private static final int NORMAL_LIMIT = 1024;
+    private static final int MULTIPART_LIMIT = 8192;
+    private static final int PENDING_AUTH_LIMIT = 2048;
+
+    @Test
+    void rejectsOrdinaryOversizedRequestFromHeadersBeforeBodyAggregation() {
+        EmbeddedChannel channel = new EmbeddedChannel(new HttpRequestSizeGuard(
+                NORMAL_LIMIT, MULTIPART_LIMIT, PENDING_AUTH_LIMIT,
+                Runnable::run, token -> false));
+        var request = request("/api/anything", "application/json", NORMAL_LIMIT + 1L, null);
+
+        assertThat(channel.writeInbound(request)).isFalse();
+
+        FullHttpResponse response = channel.readOutbound();
+        assertThat(response.status()).isEqualTo(HttpResponseStatus.REQUEST_ENTITY_TOO_LARGE);
+        assertThat(channel.isOpen()).isFalse();
+        response.release();
+    }
+
+    @Test
+    void authenticatesOffCallingThreadAndHoldsMessagesUntilAuthorized() throws Exception {
+        ExecutorService authorizationExecutor = Executors.newSingleThreadExecutor();
+        CountDownLatch authorizerEntered = new CountDownLatch(1);
+        CountDownLatch allowAuthorization = new CountDownLatch(1);
+        CountDownLatch authorizerFinished = new CountDownLatch(1);
+        AtomicReference<Thread> authorizerThread = new AtomicReference<>();
+        Thread callingThread = Thread.currentThread();
+
+        EmbeddedChannel channel = new EmbeddedChannel(new HttpRequestSizeGuard(
+                NORMAL_LIMIT, MULTIPART_LIMIT, PENDING_AUTH_LIMIT,
+                authorizationExecutor, token -> {
+                    authorizerThread.set(Thread.currentThread());
+                    authorizerEntered.countDown();
+                    try {
+                        return allowAuthorization.await(5, TimeUnit.SECONDS)
+                                && "valid".equals(token);
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        return false;
+                    } finally {
+                        authorizerFinished.countDown();
+                    }
+                }));
+
+        try {
+            var request = request("/web/mail/send/multipart",
+                    "multipart/form-data; boundary=x", 512, "valid");
+            var body = new DefaultHttpContent(Unpooled.wrappedBuffer(new byte[512]));
+
+            assertThat(channel.writeInbound(request)).isFalse();
+            assertThat(authorizerEntered.await(5, TimeUnit.SECONDS)).isTrue();
+            assertThat(authorizerThread.get()).isNotSameAs(callingThread);
+            assertThat(channel.config().isAutoRead()).isFalse();
+
+            assertThat(channel.writeInbound(body)).isFalse();
+            assertThat(channel.writeInbound(LastHttpContent.EMPTY_LAST_CONTENT)).isFalse();
+            assertThat((Object) channel.readInbound()).isNull();
+
+            allowAuthorization.countDown();
+            assertThat(authorizerFinished.await(5, TimeUnit.SECONDS)).isTrue();
+            runPendingTasksUntil(channel, () -> channel.inboundMessages().size() == 3);
+
+            assertThat((Object) channel.readInbound()).isSameAs(request);
+            assertThat((Object) channel.readInbound()).isSameAs(body);
+            assertThat((Object) channel.readInbound())
+                    .isSameAs(LastHttpContent.EMPTY_LAST_CONTENT);
+            assertThat(channel.config().isAutoRead()).isTrue();
+        } finally {
+            allowAuthorization.countDown();
+            channel.finishAndReleaseAll();
+            authorizationExecutor.shutdownNow();
+        }
+    }
+
+    @Test
+    void releasesBufferedContentAndReturns401WhenAuthorizationFails() throws Exception {
+        ExecutorService authorizationExecutor = Executors.newSingleThreadExecutor();
+        CountDownLatch authorizerEntered = new CountDownLatch(1);
+        CountDownLatch finishAuthorization = new CountDownLatch(1);
+        CountDownLatch authorizerFinished = new CountDownLatch(1);
+        EmbeddedChannel channel = new EmbeddedChannel(new HttpRequestSizeGuard(
+                NORMAL_LIMIT, MULTIPART_LIMIT, PENDING_AUTH_LIMIT,
+                authorizationExecutor, token -> {
+                    authorizerEntered.countDown();
+                    try {
+                        finishAuthorization.await(5, TimeUnit.SECONDS);
+                        return false;
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                        return false;
+                    } finally {
+                        authorizerFinished.countDown();
+                    }
+                }));
+
+        try {
+            var request = request("/web/mail/send/multipart",
+                    "multipart/form-data; boundary=x", 512, "invalid");
+            var body = new DefaultHttpContent(Unpooled.wrappedBuffer(new byte[512]));
+
+            assertThat(channel.writeInbound(request)).isFalse();
+            assertThat(authorizerEntered.await(5, TimeUnit.SECONDS)).isTrue();
+            assertThat(channel.writeInbound(body)).isFalse();
+            assertThat(body.refCnt()).isOne();
+
+            finishAuthorization.countDown();
+            assertThat(authorizerFinished.await(5, TimeUnit.SECONDS)).isTrue();
+            runPendingTasksUntil(channel, () -> !channel.outboundMessages().isEmpty());
+
+            FullHttpResponse response = channel.readOutbound();
+            assertThat(response.status()).isEqualTo(HttpResponseStatus.UNAUTHORIZED);
+            assertThat(body.refCnt()).isZero();
+            assertThat((Object) channel.readInbound()).isNull();
+            response.release();
+        } finally {
+            finishAuthorization.countDown();
+            channel.finishAndReleaseAll();
+            authorizationExecutor.shutdownNow();
+        }
+    }
+
+    @Test
+    void rejectsWhenPendingAuthorizationBufferIsExceeded() throws Exception {
+        ExecutorService authorizationExecutor = Executors.newSingleThreadExecutor();
+        CountDownLatch authorizerEntered = new CountDownLatch(1);
+        CountDownLatch finishAuthorization = new CountDownLatch(1);
+        EmbeddedChannel channel = new EmbeddedChannel(new HttpRequestSizeGuard(
+                NORMAL_LIMIT, MULTIPART_LIMIT, 16,
+                authorizationExecutor, token -> {
+                    authorizerEntered.countDown();
+                    try {
+                        finishAuthorization.await(5, TimeUnit.SECONDS);
+                    } catch (InterruptedException e) {
+                        Thread.currentThread().interrupt();
+                    }
+                    return true;
+                }));
+
+        try {
+            assertThat(channel.writeInbound(request("/web/mail/send/multipart",
+                    "multipart/form-data; boundary=x", 17, "valid"))).isFalse();
+            assertThat(authorizerEntered.await(5, TimeUnit.SECONDS)).isTrue();
+
+            var body = new DefaultHttpContent(Unpooled.wrappedBuffer(new byte[17]));
+            assertThat(channel.writeInbound(body)).isFalse();
+
+            FullHttpResponse response = channel.readOutbound();
+            assertThat(response.status()).isEqualTo(HttpResponseStatus.SERVICE_UNAVAILABLE);
+            assertThat(body.refCnt()).isZero();
+            response.release();
+        } finally {
+            finishAuthorization.countDown();
+            channel.finishAndReleaseAll();
+            authorizationExecutor.shutdownNow();
+        }
+    }
+
+    @Test
+    void inlineExecutorFailsClosedWithoutCallingPotentiallyBlockingAuthorizer() {
+        AtomicBoolean authorizerCalled = new AtomicBoolean();
+        EmbeddedChannel channel = new EmbeddedChannel(new HttpRequestSizeGuard(
+                NORMAL_LIMIT, MULTIPART_LIMIT, PENDING_AUTH_LIMIT,
+                Runnable::run, token -> {
+                    authorizerCalled.set(true);
+                    return true;
+                }));
+
+        assertThat(channel.writeInbound(request("/web/mail/send/multipart",
+                "multipart/form-data; boundary=x", 512, "valid"))).isFalse();
+
+        FullHttpResponse response = channel.readOutbound();
+        assertThat(response.status()).isEqualTo(HttpResponseStatus.SERVICE_UNAVAILABLE);
+        assertThat(authorizerCalled).isFalse();
+        response.release();
+    }
+
+    @Test
+    void enforcesActualChunkedBytesWhenContentLengthIsMissing() {
+        EmbeddedChannel channel = new EmbeddedChannel(new HttpRequestSizeGuard(
+                NORMAL_LIMIT, MULTIPART_LIMIT, PENDING_AUTH_LIMIT,
+                Runnable::run, token -> false));
+        var request = request("/api/anything", "application/octet-stream", -1, null);
+        assertThat(channel.writeInbound(request)).isTrue();
+        Object forwardedRequest = channel.readInbound();
+        assertThat(forwardedRequest).isSameAs(request);
+
+        var body = new DefaultHttpContent(Unpooled.wrappedBuffer(new byte[NORMAL_LIMIT + 1]));
+        assertThat(channel.writeInbound(body)).isFalse();
+
+        FullHttpResponse response = channel.readOutbound();
+        assertThat(response.status()).isEqualTo(HttpResponseStatus.REQUEST_ENTITY_TOO_LARGE);
+        response.release();
+    }
+
+    @Test
+    void guardIsInstalledBeforeLargeAggregator() {
+        NettyHttpServerProperties properties = new NettyHttpServerProperties();
+        properties.setCompression(false);
+        properties.setMaxContentLength(NORMAL_LIMIT);
+        properties.setMaxMultipartSize(MULTIPART_LIMIT);
+        properties.setLargeUploadAuthBufferLimit(PENDING_AUTH_LIMIT);
+
+        ExecutorService authorizationExecutor = Executors.newSingleThreadExecutor();
+        EmbeddedChannel channel = new EmbeddedChannel();
+        try {
+            var initializer = new HttpChannelInitializer(
+                    properties,
+                    new RouteRegistry(),
+                    List.of(),
+                    Runnable::run,
+                    null,
+                    null,
+                    authorizationExecutor,
+                    token -> true);
+            initializer.configurePipeline(channel.pipeline());
+
+            List<String> names = channel.pipeline().names();
+            assertThat(names.indexOf("request-size-guard"))
+                    .isLessThan(names.indexOf("aggregator"));
+        } finally {
+            channel.finishAndReleaseAll();
+            authorizationExecutor.shutdownNow();
+        }
+    }
+
+    @Test
+    void serverAuthorizationExecutorHasBoundedWorkersAndQueue() {
+        NettyHttpServerProperties properties = new NettyHttpServerProperties();
+        properties.setLargeUploadAuthThreads(2);
+        properties.setLargeUploadAuthQueueCapacity(3);
+
+        ThreadPoolExecutor executor =
+                NettyHttpServer.createLargeUploadAuthExecutor(properties);
+        try {
+            assertThat(executor.getCorePoolSize()).isEqualTo(2);
+            assertThat(executor.getMaximumPoolSize()).isEqualTo(2);
+            assertThat(executor.getQueue().remainingCapacity()).isEqualTo(3);
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+
+    @Test
+    void serverShutdownClosesAuthorizationExecutor() throws Exception {
+        NettyHttpServerProperties properties = new NettyHttpServerProperties();
+        ThreadPoolExecutor executor =
+                NettyHttpServer.createLargeUploadAuthExecutor(properties);
+        NettyHttpServer server = new NettyHttpServer(
+                properties, new RouteRegistry(), List.of(), null, null, null);
+
+        var executorField = NettyHttpServer.class
+                .getDeclaredField("largeUploadAuthExecutor");
+        executorField.setAccessible(true);
+        executorField.set(server, executor);
+
+        server.shutdown();
+
+        assertThat(executor.isShutdown()).isTrue();
+    }
+
+    private static void runPendingTasksUntil(
+            EmbeddedChannel channel, java.util.function.BooleanSupplier complete)
+            throws InterruptedException {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+        while (!complete.getAsBoolean() && System.nanoTime() < deadline) {
+            channel.runPendingTasks();
+            Thread.sleep(1);
+        }
+        channel.runPendingTasks();
+        assertThat(complete.getAsBoolean()).isTrue();
+    }
+
+    private static DefaultHttpRequest request(
+            String uri, String contentType, long contentLength, String token) {
+        var request = new DefaultHttpRequest(HttpVersion.HTTP_1_1, HttpMethod.POST, uri);
+        request.headers().set(HttpHeaderNames.CONTENT_TYPE, contentType);
+        if (contentLength >= 0) {
+            request.headers().set(HttpHeaderNames.CONTENT_LENGTH, contentLength);
+        }
+        if (token != null) {
+            request.headers().set("X-Session-Token", token);
+        }
+        return request;
+    }
+}
diff --git a/src/test/java/net/lmyz/lmyzmail/netty/minecraft/gui/MailViewManagerSecurityTest.java b/src/test/java/net/lmyz/lmyzmail/netty/minecraft/gui/MailViewManagerSecurityTest.java
