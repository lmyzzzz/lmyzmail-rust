+import java.util.function.Predicate;
+
+/**
+ * Enforces route-aware request limits before {@code HttpObjectAggregator}.
+ * Ordinary traffic uses the small global limit. The large multipart mail
+ * endpoint keeps its configured upload limit only after its session header is
+ * validated outside the Netty event loop, so anonymous traffic cannot force a
+ * large aggregation or block I/O threads on session/JPA access.
+ */
+final class HttpRequestSizeGuard extends ChannelInboundHandlerAdapter {
+
+    static final String LARGE_MULTIPART_PATH = "/web/mail/send/multipart";
+    private static final int MAX_PENDING_AUTH_MESSAGES = 128;
+
+    private final int normalLimit;
+    private final int multipartLimit;
+    private final int pendingAuthBufferLimit;
+    private final Executor authorizationExecutor;
+    private final Predicate<String> largeUploadAuthorizer;
+    private final Deque<Object> pendingAuthorizationMessages = new ArrayDeque<>();
+
+    private long receivedBytes;
+    private int currentLimit;
+    private int pendingAuthorizationBytes;
+    private long authorizationGeneration;
+    private boolean awaitingAuthorization;
+    private boolean restoreAutoRead;
+    private boolean rejected;
+
+    HttpRequestSizeGuard(int normalLimit,
+                         int multipartLimit,
+                         int pendingAuthBufferLimit,
+                         Executor authorizationExecutor,
+                         Predicate<String> largeUploadAuthorizer) {
+        if (normalLimit <= 0 || multipartLimit < normalLimit) {
+            throw new IllegalArgumentException("Invalid HTTP request limits");
+        }
+        if (pendingAuthBufferLimit <= 0) {
+            throw new IllegalArgumentException("Invalid pending authorization buffer limit");
+        }
+        this.normalLimit = normalLimit;
+        this.multipartLimit = multipartLimit;
+        this.pendingAuthBufferLimit = pendingAuthBufferLimit;
+        this.authorizationExecutor = Objects.requireNonNull(authorizationExecutor);
+        this.largeUploadAuthorizer = Objects.requireNonNull(largeUploadAuthorizer);
+        this.currentLimit = normalLimit;
+    }
+
+    @Override
+    public void channelRead(ChannelHandlerContext ctx, Object msg) {
+        if (rejected) {
+            ReferenceCountUtil.release(msg);
+            return;
+        }
+
+        if (awaitingAuthorization) {
+            bufferWhileAuthorizationIsPending(ctx, msg);
+            return;
+        }
+
+        if (msg instanceof HttpRequest request) {
+            receivedBytes = 0;
+            boolean largeMultipartRoute = isLargeMultipartRoute(request);
+            currentLimit = largeMultipartRoute ? multipartLimit : normalLimit;
+
+            long declaredLength;
+            try {
+                declaredLength = HttpUtil.getContentLength(request, -1L);
+            } catch (RuntimeException e) {
+                reject(ctx, msg, HttpResponseStatus.BAD_REQUEST);
+                return;
+            }
+            if (declaredLength < -1) {
+                reject(ctx, msg, HttpResponseStatus.BAD_REQUEST);
+                return;
+            }
+            if (declaredLength > currentLimit) {
+                reject(ctx, msg, HttpResponseStatus.REQUEST_ENTITY_TOO_LARGE);
+                return;
+            }
