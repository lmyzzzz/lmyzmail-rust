@@ -0,0 +1,71 @@
+package net.lmyz.lmyzmail.asciiart;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class MailRendererNativeImageSecurityTest {
+
+    private static final Path SOURCE = Path.of("asciiart_linux", "src", "mr_container.cpp");
+    private static final Path HEADER = Path.of("asciiart_linux", "src", "mr_container.h");
+
+    @Test
+    void rasterDimensionsAreProbedAndBudgetedBeforeDecodeAllocation() throws IOException {
+        String function = functionBody(Files.readString(SOURCE),
+                "mr_mail_container::decode_raster", "mr_mail_container::decode_svg");
+
+        assertThat(function)
+                .contains("stbi_info_from_memory")
+                .contains("reserve_image_pixels(probed_w, probed_h)")
+                .contains("stbi_load_from_memory");
+        assertThat(function.indexOf("stbi_info_from_memory"))
+                .isLessThan(function.indexOf("stbi_load_from_memory"));
+        assertThat(function.indexOf("reserve_image_pixels"))
+                .isLessThan(function.indexOf("stbi_load_from_memory"));
+        assertThat(function).contains("release_image_pixels(probed_w, probed_h)");
+    }
+
+    @Test
+    void svgRejectsInvalidDimensionsAndUsesTheSamePixelBudget() throws IOException {
+        String function = functionBody(Files.readString(SOURCE),
+                "mr_mail_container::decode_svg", "mr_mail_container::decode_data_uri");
+
+        assertThat(function)
+                .contains("std::isfinite(img->width)")
+                .contains("std::isfinite(img->height)")
+                .contains("reserve_image_pixels(w, h)")
+                .contains("release_image_pixels(w, h)")
+                .doesNotContain("std::min(4096");
+        assertThat(function.indexOf("reserve_image_pixels(w, h)"))
+                .isLessThan(function.indexOf("malloc(rgba_size)"));
+    }
+
+    @Test
+    void containerEnforcesACumulativeDecodedPixelBudget() throws IOException {
+        String source = Files.readString(SOURCE);
+        String header = Files.readString(HEADER);
+
+        assertThat(header)
+                .contains("m_image_pixels_used = 0")
+                .contains("reserve_image_pixels(int width, int height)")
+                .contains("release_image_pixels(int width, int height)");
+        assertThat(source)
+                .contains("kMaxImagePixels          = 4ULL * 1024ULL * 1024ULL")
+                .contains("kMaxContainerImagePixels = 16ULL * 1024ULL * 1024ULL")
+                .contains("pixels > kMaxContainerImagePixels - m_image_pixels_used")
+                .contains("m_image_pixels_used += pixels")
+                .contains("m_image_pixels_used -= pixels");
+    }
+
+    private static String functionBody(String source, String startMarker, String endMarker) {
+        int start = source.indexOf(startMarker);
+        int end = source.indexOf(endMarker, start + startMarker.length());
+        assertThat(start).as("start marker %s", startMarker).isNotNegative();
+        assertThat(end).as("end marker %s", endMarker).isGreaterThan(start);
+        return source.substring(start, end);
+    }
+}
diff --git a/src/test/java/net/lmyz/lmyzmail/inbound/MtaStsServiceSecurityTest.java b/src/test/java/net/lmyz/lmyzmail/inbound/MtaStsServiceSecurityTest.java
