+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+
+@SpringJUnitConfig(WebMailController.class)
+class WebMailControllerSecurityTest {
+
+    private static final String SESSION_TOKEN = "top-secret-session-token";
+    private static final String MAILBOX = "alice@example.test";
+
+    @Autowired
+    private WebMailController controller;
+
+    @MockitoBean
+    private SessionService sessionService;
+
+    @MockitoBean
+    private MailReadService mailReadService;
+
+    @MockitoBean
+    private MailboxService mailboxService;
+
+    @MockitoBean
+    private OutboundMailService outboundMailService;
+
+    @MockitoBean
+    private RateLimitService rateLimitService;
+
+    @MockitoBean
+    private BotmailProperties botmailProperties;
+
+    @MockitoBean
+    private UserDataService userDataService;
+
+    @BeforeEach
+    void authenticateSession() {
+        when(sessionService.validateTokenAndGetMailbox(SESSION_TOKEN)).thenReturn(Optional.of(MAILBOX));
+    }
+
+    @Test
+    void cidResolutionDoesNotInjectSessionTokenIntoUntrustedHtml() throws Exception {
+        String html = "<img src=\"https://attacker.example/collect/cid:logo\">"
+                + "<img src=\"cid:logo\">";
+        MailReadService.EmailDetail detail = new MailReadService.EmailDetail(
+                "subject",
+                "sender@example.test",
+                null,
+                List.of(MAILBOX),
+                List.of(),
+                "today",
+                null,
+                html,
+                html,
+                List.of(new MailReadService.AttachmentMeta(
+                        "logo.png", "image/png", 3, "logo", true)),
+                "<message@example.test>",
+                null,
+                null,
+                "From: sender@example.test"
+        );
+        when(mailReadService.readEmailDetail(MAILBOX, "inbox", "mail.eml")).thenReturn(detail);
+        when(userDataService.getEmailLabels(MAILBOX, "inbox", "mail.eml")).thenReturn(List.of());
+
+        NettyHttpResponse response = controller.getEmailDetail(
+                SESSION_TOKEN, "inbox", "mail.eml");
+
+        assertThat(response.status()).isEqualTo(200);
+        Map<?, ?> body = (Map<?, ?>) response.body();
+        String returnedHtml = (String) body.get("html");
+        assertThat(returnedHtml)
+                .doesNotContain(SESSION_TOKEN)
+                .contains("https://attacker.example/collect/cid:logo")
+                .contains("src=\"cid:logo\"");
+    }
+
+    @Test
+    void activeAttachmentIsForcedToDownloadAsNonExecutableContent() throws Exception {
+        when(mailReadService.readAttachment(MAILBOX, "inbox", "mail.eml", 0))
+                .thenReturn(new MailReadService.AttachmentData(
+                        "payload.html",
+                        "text/html; charset=UTF-8",
+                        "<script>parent.pwned=true</script>".getBytes(StandardCharsets.UTF_8),
+                        true));
+
+        NettyHttpResponse response = controller.getAttachment(
+                SESSION_TOKEN, null, "inbox", "mail.eml", 0);
+
+        assertThat(response.status()).isEqualTo(200);
+        assertThat(response.headers())
+                .containsEntry("Content-Type", "application/octet-stream")
+                .containsEntry("X-Content-Type-Options", "nosniff")
+                .containsEntry("Cache-Control", "private, no-store");
+        assertThat(response.headers().get("Content-Disposition")).startsWith("attachment;");
+        assertThat(response.headers().get("Content-Security-Policy")).contains("sandbox");
+    }
+
+    @Test
+    void svgAttachmentIsAlsoServedAsNonExecutableContent() throws Exception {
+        when(mailReadService.readAttachment(MAILBOX, "inbox", "mail.eml", 1))
+                .thenReturn(new MailReadService.AttachmentData(
+                        "payload.svg",
+                        "image/svg+xml",
+                        "<svg onload=\"parent.pwned=true\"></svg>".getBytes(StandardCharsets.UTF_8),
+                        true));
+
+        NettyHttpResponse response = controller.getAttachment(
+                SESSION_TOKEN, null, "inbox", "mail.eml", 1);
+
+        assertThat(response.headers())
+                .containsEntry("Content-Type", "application/octet-stream")
+                .containsEntry("X-Content-Type-Options", "nosniff");
+        assertThat(response.headers().get("Content-Disposition")).startsWith("attachment;");
+    }
+
+    @Test
+    void passiveRasterAttachmentKeepsItsMimeTypeButStillDownloads() throws Exception {
+        when(mailReadService.readAttachment(MAILBOX, "inbox", "mail.eml", 2))
+                .thenReturn(new MailReadService.AttachmentData(
+                        "logo.png", "image/png", new byte[]{1, 2, 3}, true));
+
+        NettyHttpResponse response = controller.getAttachment(
+                SESSION_TOKEN, null, "inbox", "mail.eml", 2);
+
+        assertThat(response.headers()).containsEntry("Content-Type", "image/png");
+        assertThat(response.headers().get("Content-Disposition")).startsWith("attachment;");
+    }
+
+    @Test
+    void closingAttachmentResponseStreamDeletesBackingTemporaryFile(
+            @TempDir Path tempDir) throws Exception {
+        Path tempFile = tempDir.resolve("large-attachment.tmp");
+        Files.write(tempFile, new byte[]{1, 2, 3, 4});
+        when(mailReadService.readAttachment(MAILBOX, "inbox", "mail.eml", 3))
+                .thenReturn(new MailReadService.AttachmentData(
+                        "large.bin", "application/octet-stream", tempFile,
+                        Files.size(tempFile), false));
+
+        NettyHttpResponse response = controller.getAttachment(
+                SESSION_TOKEN, null, "inbox", "mail.eml", 3);
+
+        assertThat(tempFile).exists();
+        NettyHttpResponse.StreamBody streamBody =
+                (NettyHttpResponse.StreamBody) response.body();
+        streamBody.inputStream().close();
+        assertThat(tempFile).doesNotExist();
+    }
+
+    @Test
+    void attachmentEndpointRejectsSessionTokenInQueryString() {
+        NettyHttpResponse response = controller.getAttachment(
+                null, SESSION_TOKEN, "inbox", "mail.eml", 0);
+
+        assertThat(response.status()).isEqualTo(401);
+        verifyNoInteractions(mailReadService);
+    }
+
+    @Test
+    void queueStatusDoesNotExposeAnotherMailboxTask() {
+        OutboundMailService.MailStatusResult otherMailboxStatus = status(42L, "other.eml");
+        when(outboundMailService.getMailStatus(42L)).thenReturn(Optional.of(otherMailboxStatus));
+        when(outboundMailService.getMailStatus(42L, MAILBOX)).thenReturn(Optional.empty());
+
+        NettyHttpResponse response = controller.getSendStatus(SESSION_TOKEN, 42L);
+
+        assertThat(response.status()).isEqualTo(404);
+        verify(outboundMailService).getMailStatus(42L, MAILBOX);
+        verify(outboundMailService, never()).getMailStatus(42L);
+    }
+
+    @Test
+    void fileStatusDoesNotExposeAnotherMailboxTask() {
+        OutboundMailService.MailStatusResult otherMailboxStatus = status(42L, "other.eml");
+        when(outboundMailService.getMailStatusBySentFileName("other.eml"))
+                .thenReturn(Optional.of(otherMailboxStatus));
+        when(outboundMailService.getMailStatusBySentFileName("other.eml", MAILBOX))
+                .thenReturn(Optional.empty());
+
+        NettyHttpResponse response = controller.getSendStatusByFile(
+                SESSION_TOKEN, "other.eml");
+
+        assertThat(response.status()).isEqualTo(404);
+        verify(outboundMailService).getMailStatusBySentFileName("other.eml", MAILBOX);
+        verify(outboundMailService, never()).getMailStatusBySentFileName("other.eml");
+    }
+
+    @Test
+    void queueStatusOwnedByAuthenticatedMailboxRemainsAvailable() {
+        OutboundMailService.MailStatusResult ownStatus = status(7L, "alice.eml");
+        when(outboundMailService.getMailStatus(7L, MAILBOX)).thenReturn(Optional.of(ownStatus));
+
+        NettyHttpResponse response = controller.getSendStatus(SESSION_TOKEN, 7L);
+
+        assertThat(response.status()).isEqualTo(200);
+        assertThat(((Map<?, ?>) response.body()).get("queueId")).isEqualTo(7L);
+    }
+
+    private static OutboundMailService.MailStatusResult status(Long queueId, String sentFileName) {
+        return new OutboundMailService.MailStatusResult(
+                queueId,
+                "<message@example.test>",
+                "PENDING",
+                "PENDING",
+                0,
+                5,
+                null,
+                Instant.now(),
+                null,
+                Instant.now(),
+                sentFileName,
+                null,
+                List.of()
+        );
+    }
+}
