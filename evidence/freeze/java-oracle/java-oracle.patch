+        int readable = msg instanceof HttpContent content
+                ? content.content().readableBytes()
+                : 0;
+        if (receivedBytes > multipartLimit - (long) readable) {
+            reject(ctx, msg, HttpResponseStatus.REQUEST_ENTITY_TOO_LARGE);
+            return false;
+        }
+        if (pendingAuthorizationBytes > pendingAuthBufferLimit - readable) {
+            reject(ctx, msg, HttpResponseStatus.SERVICE_UNAVAILABLE);
+            return false;
+        }
+
+        receivedBytes += readable;
+        pendingAuthorizationBytes += readable;
+        pendingAuthorizationMessages.addLast(msg);
+        return true;
+    }
+
+    private boolean accountForContent(ChannelHandlerContext ctx, Object msg, int limit) {
+        if (!(msg instanceof HttpContent content)) {
+            return true;
+        }
+        int readable = content.content().readableBytes();
+        if (receivedBytes > limit - (long) readable) {
+            reject(ctx, msg, HttpResponseStatus.REQUEST_ENTITY_TOO_LARGE);
+            return false;
+        }
+        receivedBytes += readable;
+        return true;
+    }
+
+    private static boolean isLargeMultipartRoute(HttpRequest request) {
+        if (request.method() != HttpMethod.POST) return false;
+        String path = new QueryStringDecoder(request.uri()).path();
+        if (!LARGE_MULTIPART_PATH.equals(path)) return false;
+        String contentType = request.headers().get(HttpHeaderNames.CONTENT_TYPE);
+        return contentType != null
+                && contentType.regionMatches(true, 0, "multipart/form-data", 0,
+                "multipart/form-data".length());
+    }
+
+    private void reject(ChannelHandlerContext ctx, Object msg, HttpResponseStatus status) {
+        rejected = true;
+        awaitingAuthorization = false;
+        authorizationGeneration++;
+        if (msg != null) {
+            ReferenceCountUtil.release(msg);
+        }
+        releasePendingMessages();
+        ctx.channel().config().setAutoRead(false);
+        restoreAutoRead = false;
+
+        var response = new DefaultFullHttpResponse(HttpVersion.HTTP_1_1, status);
+        response.headers().setInt(HttpHeaderNames.CONTENT_LENGTH, 0);
+        response.headers().set(HttpHeaderNames.CONNECTION, "close");
+        ctx.writeAndFlush(response).addListener(ChannelFutureListener.CLOSE);
+    }
+
+    private void resumeReads(ChannelHandlerContext ctx) {
+        boolean shouldResume = restoreAutoRead;
+        restoreAutoRead = false;
+        if (shouldResume && ctx.channel().isActive()) {
+            ctx.channel().config().setAutoRead(true);
+        }
+    }
+
+    private void resetRequestBudget() {
+        receivedBytes = 0;
+        currentLimit = normalLimit;
+    }
+
+    private void releasePendingMessages() {
+        pendingAuthorizationBytes = 0;
+        while (!pendingAuthorizationMessages.isEmpty()) {
+            ReferenceCountUtil.release(pendingAuthorizationMessages.removeFirst());
+        }
+    }
+
+    @Override
+    public void channelInactive(ChannelHandlerContext ctx) throws Exception {
+        awaitingAuthorization = false;
+        authorizationGeneration++;
+        releasePendingMessages();
+        super.channelInactive(ctx);
+    }
+
+    @Override
+    public void handlerRemoved(ChannelHandlerContext ctx) throws Exception {
+        awaitingAuthorization = false;
+        authorizationGeneration++;
+        releasePendingMessages();
+        super.handlerRemoved(ctx);
+    }
+
+    private enum AuthorizationResult {
+        AUTHORIZED,
+        UNAUTHORIZED,
+        UNAVAILABLE
+    }
+}
