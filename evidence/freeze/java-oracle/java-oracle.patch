+        properties.setMaxConnectionsPerIp(1);
+        SmtpConnectionTracker tracker = new SmtpConnectionTracker(properties);
+
+        Channel channel = mock(Channel.class);
+        InetSocketAddress remote = new InetSocketAddress("203.0.113.55", 2525);
+        when(channel.remoteAddress()).thenReturn(remote);
