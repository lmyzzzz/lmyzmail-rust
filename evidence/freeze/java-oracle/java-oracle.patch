+            authorizationExecutor.execute(
+                    () -> authorize(ctx, generation, token, eventLoopThread));
+        } catch (RejectedExecutionException e) {
+            authorizationComplete(ctx, generation, AuthorizationResult.UNAVAILABLE);
+        } catch (RuntimeException e) {
+            authorizationComplete(ctx, generation, AuthorizationResult.UNAVAILABLE);
+        }
+    }
+
+    private void authorize(ChannelHandlerContext ctx,
+                           long generation,
+                           String token,
+                           Thread eventLoopThread) {
+        // Fail closed if a caller accidentally supplies an inline/event-loop
+        // executor. The potentially blocking authorizer must never run there.
+        if (Thread.currentThread() == eventLoopThread) {
+            scheduleAuthorizationResult(
+                    ctx, generation, AuthorizationResult.UNAVAILABLE);
+            return;
+        }
