+package net.lmyz.lmyzmail.outbound;
+
+import net.lmyz.lmyzmail.config.BotmailProperties;
+import net.lmyz.lmyzmail.config.CustomSslContextFactory;
+import net.lmyz.lmyzmail.inbound.MailStoreProperties;
+import net.lmyz.lmyzmail.inbound.MtaStsService;
+import net.lmyz.lmyzmail.mailbox.repo.MailboxRepository;
+import net.lmyz.lmyzmail.mailbox.service.EmailIndexService;
+import net.lmyz.lmyzmail.ratelimit.RateLimitService;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.junit.jupiter.api.io.TempDir;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.security.crypto.password.PasswordEncoder;
+
+import java.nio.file.Path;
+import java.time.Instant;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.anyCollection;
+import static org.mockito.ArgumentMatchers.anyList;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@ExtendWith(MockitoExtension.class)
+class OutboundMailServiceOwnershipTest {
+
+    private static final String ALICE = "alice@example.test";
+
+    @TempDir
+    Path tempDir;
+
+    @Mock
+    BotmailProperties botmailProperties;
+    @Mock
+    MxResolver mxResolver;
+    @Mock
+    DkimSigner dkimSigner;
+    @Mock
+    MailboxRepository mailboxRepository;
+    @Mock
+    PasswordEncoder passwordEncoder;
+    @Mock
+    RateLimitService rateLimitService;
+    @Mock
+    CustomSslContextFactory sslContextFactory;
+    @Mock
+    EmailIndexService emailIndexService;
+    @Mock
+    OutboundMailQueueRepository queueRepository;
+    @Mock
+    MailQueueRedisService mailQueueRedisService;
+    @Mock
+    MtaStsService mtaStsService;
+    @Mock
+    SmtpConnectionPool connectionPool;
+
+    private OutboundMailService service;
+
+    @BeforeEach
+    void setUp() {
+        MailStoreProperties mailStoreProperties = new MailStoreProperties();
+        mailStoreProperties.setBase(tempDir.resolve("mail-store").toString());
+        service = new OutboundMailService(
+                botmailProperties,
+                mxResolver,
+                dkimSigner,
+                mailboxRepository,
+                passwordEncoder,
+                rateLimitService,
+                sslContextFactory,
+                mailStoreProperties,
+                emailIndexService,
+                queueRepository,
+                mailQueueRedisService,
+                mtaStsService,
+                connectionPool
+        );
+    }
+
+    @Test
+    void redisQueueStatusIsReturnedOnlyToItsSender() {
+        MailQueueRedisService.TaskDetail detail = redisTask(11L, "Alice@Example.Test", "alice.eml");
+        when(mailQueueRedisService.getTaskDetail(11L)).thenReturn(Optional.of(detail));
+        when(mailQueueRedisService.getDomainStatuses(11L)).thenReturn(Map.of());
+
+        assertThat(service.getMailStatus(11L, ALICE)).isPresent();
+        assertThat(service.getMailStatus(11L, "mallory@example.test")).isEmpty();
+
+        verify(queueRepository, never()).findById(11L);
+        verify(queueRepository).findByIdAndSenderAddress(11L, "mallory@example.test");
+    }
+
+    @Test
+    void databaseQueueStatusUsesSenderScopedQuery() {
+        OutboundMailQueue entity = databaseTask(22L, ALICE, "alice.eml");
+        when(mailQueueRedisService.getTaskDetail(22L)).thenReturn(Optional.empty());
+        when(queueRepository.findByIdAndSenderAddress(22L, ALICE)).thenReturn(Optional.of(entity));
+        when(mailQueueRedisService.getDomainStatuses(22L)).thenReturn(Map.of());
+
+        assertThat(service.getMailStatus(22L, ALICE))
+                .get()
+                .extracting(OutboundMailService.MailStatusResult::queueId)
+                .isEqualTo(22L);
+
+        verify(queueRepository, never()).findById(22L);
+    }
+
+    @Test
+    void sentFileIndexCannotCrossMailboxBoundary() {
+        when(mailQueueRedisService.getTaskIdBySentFileName("shared.eml")).thenReturn(33L);
+        when(mailQueueRedisService.getTaskDetail(33L))
+                .thenReturn(Optional.of(redisTask(33L, "bob@example.test", "shared.eml")));
+        when(queueRepository.findBySentFileNameAndSenderAddress("shared.eml", ALICE))
+                .thenReturn(Optional.empty());
+
+        assertThat(service.getMailStatusBySentFileName("shared.eml", ALICE)).isEmpty();
+
+        verify(queueRepository, never()).findBySentFileName("shared.eml");
+        verify(queueRepository).findBySentFileNameAndSenderAddress("shared.eml", ALICE);
+    }
+
+    @Test
+    void batchSentFolderStatusFiltersRedisTasksBySenderAndScopesDatabaseFallback() {
+        when(mailQueueRedisService.getTaskIdsBySentFileNames(anyCollection()))
+                .thenReturn(Map.of("alice.eml", 41L, "bob.eml", 42L));
+        when(mailQueueRedisService.getTaskDetails(anyList()))
+                .thenReturn(Map.of(
+                        41L, redisTask(41L, ALICE, "alice.eml"),
+                        42L, redisTask(42L, "bob@example.test", "bob.eml")));
+        when(mailQueueRedisService.getDomainStatuses(41L)).thenReturn(Map.of());
+        when(queueRepository.findBySentFileNameInAndSenderAddress(
+                anyCollection(), org.mockito.ArgumentMatchers.eq(ALICE)))
+                .thenReturn(List.of());
+
+        Map<String, OutboundMailService.MailStatusResult> result = service
+                .getMailStatusBySentFileNames(List.of("alice.eml", "bob.eml"), ALICE);
+
+        assertThat(result).containsOnlyKeys("alice.eml");
+        verify(queueRepository).findBySentFileNameInAndSenderAddress(
+                anyCollection(), org.mockito.ArgumentMatchers.eq(ALICE));
+    }
+
+    private static MailQueueRedisService.TaskDetail redisTask(
+            Long id, String sender, String sentFileName) {
+        return new MailQueueRedisService.TaskDetail(
+                id,
+                sender,
+                null,
+                "subject",
+                "<message-" + id + "@example.test>",
+                5,
+                0,
+                sentFileName,
+                null,
+                null,
+                null,
+                Instant.now(),
+                Instant.now(),
+                null,
+                "PENDING"
+        );
+    }
+
+    private static OutboundMailQueue databaseTask(
+            Long id, String sender, String sentFileName) {
+        OutboundMailQueue task = new OutboundMailQueue();
+        task.setId(id);
+        task.setSenderAddress(sender);
+        task.setRecipientsJson("[]");
+        task.setSubject("subject");
+        task.setMessageId("<message-" + id + "@example.test>");
+        task.setSentFileName(sentFileName);
+        task.setStatus(OutboundMailQueue.Status.PENDING);
+        return task;
+    }
+}
