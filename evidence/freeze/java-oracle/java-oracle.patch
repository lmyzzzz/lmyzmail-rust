+bool mr_mail_container::reserve_image_pixels(int width, int height) {
+    if (width <= 0 || height <= 0 ||
+        width > kMaxImageDimension || height > kMaxImageDimension) {
+        return false;
+    }
+
+    const uint64_t pixels = static_cast<uint64_t>(width) *
+                            static_cast<uint64_t>(height);
+    if (pixels == 0 || pixels > kMaxImagePixels ||
+        m_image_pixels_used > kMaxContainerImagePixels ||
+        pixels > kMaxContainerImagePixels - m_image_pixels_used) {
+        return false;
+    }
+
+    m_image_pixels_used += pixels;
+    return true;
+}
+
+void mr_mail_container::release_image_pixels(int width, int height) {
+    if (width <= 0 || height <= 0) return;
+
+    const uint64_t pixels = static_cast<uint64_t>(width) *
+                            static_cast<uint64_t>(height);
+    if (pixels <= m_image_pixels_used) {
+        m_image_pixels_used -= pixels;
+    } else {
+        m_image_pixels_used = 0;
+    }
+}
