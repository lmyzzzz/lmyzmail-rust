+package net.lmyz.lmyzmail.report.service;
+
+import org.junit.jupiter.api.Test;
+import org.xbill.DNS.*;
+import org.xbill.DNS.Record;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class ReportAddressDiscoverySecurityTest {
+
+    @Test
+    void filtersUnauthorizedExternalDmarcDestinationsAndCapsFanout() {
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                mock(Resolver.class), Runnable::run) {
+            @Override
+            public boolean verifyExternalReportingAuthorization(
+                    String reportDomain, String recipientDomain) {
+                return reportDomain.equalsIgnoreCase(recipientDomain)
+                        || recipientDomain.equalsIgnoreCase("authorized.example");
+            }
+        };
+
+        List<String> mailto = new ArrayList<>();
+        mailto.add("local@sender.example");
+        mailto.add("allowed@authorized.example");
+        mailto.add("blocked@unauthorized.example");
+        for (int i = 0; i < 20; i++) {
+            mailto.add("allowed" + i + "@authorized.example");
+        }
+
+        var filtered = service.filterAuthorizedDmarcRua(
+                "sender.example",
+                new ReportAddressDiscoveryService.ReportAddresses(mailto, List.of(
+                        "https://unauthorized.example/report")));
+
+        assertThat(filtered.mailtoAddresses())
+                .contains("local@sender.example", "allowed@authorized.example")
+                .doesNotContain("blocked@unauthorized.example");
+        assertThat(filtered.httpsEndpoints()).isEmpty();
+        assertThat(filtered.mailtoAddresses().size() + filtered.httpsEndpoints().size())
+                .isLessThanOrEqualTo(ReportAddressDiscoveryService.MAX_RUA_ADDRESSES);
+    }
+
+    @Test
+    void discoveryAppliesExternalAuthorizationAndRequiresAnExactVersionTag() throws Exception {
+        Resolver resolver = mock(Resolver.class);
+        when(resolver.send(any(Message.class))).thenAnswer(invocation ->
+                dnsResponse(invocation.getArgument(0)));
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                resolver, Runnable::run);
+
+        var addresses = service.discoverDmarcRua("sender.example");
+
+        assertThat(addresses.mailtoAddresses())
+                .containsExactly("local@sender.example", "allowed@authorized.example");
+        assertThat(addresses.httpsEndpoints()).isEmpty();
+    }
+
+    @Test
+    void malformedDmarcVersionPrefixIsNotAcceptedAsAPolicy() throws Exception {
+        Resolver resolver = mock(Resolver.class);
+        when(resolver.send(any(Message.class))).thenAnswer(invocation -> {
+            Message query = invocation.getArgument(0);
+            return responseWithTxt(query, "v=DMARC1evil; rua=mailto:attacker@example.net");
+        });
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                resolver, Runnable::run);
+
+        assertThat(service.discoverDmarcRua("malformed-policy.example").isEmpty()).isTrue();
+    }
+
+    @Test
+    void multipleValidDmarcPolicyRecordsAreRejected() throws Exception {
+        Resolver resolver = resolverReturning(
+                "v=DMARC1; rua=mailto:first@multi-dmarc.example",
+                "v=DMARC1; rua=mailto:second@multi-dmarc.example");
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                resolver, Runnable::run);
+
+        assertThat(service.discoverDmarcRua("multi-dmarc.example").isEmpty()).isTrue();
+    }
+
+    @Test
+    void multipleValidTlsRptPolicyRecordsAreRejected() throws Exception {
+        Resolver resolver = resolverReturning(
+                "v=TLSRPTv1; rua=mailto:first@sender.example",
+                "v=TLSRPTv1; rua=mailto:second@sender.example");
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                resolver, Runnable::run);
+
+        assertThat(service.discoverTlsRptRua("multi-tls.example").isEmpty()).isTrue();
+    }
+
+    @Test
+    void lookalikeOrNonLeadingVersionTagsAreRejected() throws Exception {
+        Resolver resolver = mock(Resolver.class);
+        when(resolver.send(any(Message.class))).thenAnswer(invocation -> {
+            Message query = invocation.getArgument(0);
+            String name = query.getQuestion().getName().toString();
+            return switch (name) {
+                case "_dmarc.lookalike.example." -> responseWithTxt(query,
+                        "xv=DMARC1; rua=mailto:attacker@lookalike.example");
+                case "_smtp._tls.lookalike.example." -> responseWithTxt(query,
+                        "evil=1; v=TLSRPTv1; rua=mailto:attacker@lookalike.example");
+                default -> emptyResponse(query);
+            };
+        });
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                resolver, Runnable::run);
+
+        assertThat(service.discoverDmarcRua("lookalike.example").isEmpty()).isTrue();
+        assertThat(service.discoverTlsRptRua("lookalike.example").isEmpty()).isTrue();
+    }
+
+    @Test
+    void oneInvalidAndOneValidPolicyRecordIsAccepted() throws Exception {
+        Resolver resolver = mock(Resolver.class);
+        when(resolver.send(any(Message.class))).thenAnswer(invocation -> {
+            Message query = invocation.getArgument(0);
+            String name = query.getQuestion().getName().toString();
+            return switch (name) {
+                case "_dmarc.mixed-policy.example." -> responseWithTxt(query,
+                        "xv=DMARC1; rua=mailto:attacker@mixed-policy.example",
+                        "v=DMARC1; rua=mailto:dmarc@mixed-policy.example");
+                case "_smtp._tls.mixed-policy.example." -> responseWithTxt(query,
+                        "evil=1; v=TLSRPTv1; rua=mailto:attacker@mixed-policy.example",
+                        "v=TLSRPTv1; rua=mailto:tlsrpt@mixed-policy.example");
+                default -> emptyResponse(query);
+            };
+        });
+        ReportAddressDiscoveryService service = new ReportAddressDiscoveryService(
+                resolver, Runnable::run);
+
+        assertThat(service.discoverDmarcRua("mixed-policy.example").mailtoAddresses())
+                .containsExactly("dmarc@mixed-policy.example");
+        assertThat(service.discoverTlsRptRua("mixed-policy.example").mailtoAddresses())
+                .containsExactly("tlsrpt@mixed-policy.example");
+    }
+
+    private static Message dnsResponse(Message query) throws Exception {
+        String name = query.getQuestion().getName().toString();
+        return switch (name) {
+            case "_dmarc.sender.example." -> responseWithTxt(query,
+                    "v=DMARC1; p=none; "
+                            + "rua=mailto:local@sender.example,"
+                            + "mailto:allowed@authorized.example,"
+                            + "mailto:blocked@unauthorized.example,"
+                            + "mailto:fake@malformed.example");
+            case "sender.example._report._dmarc.authorized.example." ->
+                    responseWithTxt(query, "xv=DMARC1", "v=DMARC1");
+            case "sender.example._report._dmarc.malformed.example." ->
+                    responseWithTxt(query, "v=DMARC1evil");
+            default -> emptyResponse(query);
+        };
+    }
+
+    private static Resolver resolverReturning(String... values) throws Exception {
+        Resolver resolver = mock(Resolver.class);
+        when(resolver.send(any(Message.class))).thenAnswer(invocation ->
+                responseWithTxt(invocation.getArgument(0), values));
+        return resolver;
+    }
+
+    private static Message responseWithTxt(Message query, String... values) throws Exception {
+        Message response = emptyResponse(query);
+        for (String value : values) {
+            response.addRecord(new TXTRecord(
+                    query.getQuestion().getName(), DClass.IN, 60, List.of(value)), Section.ANSWER);
+        }
+        return response;
+    }
+
+    private static Message emptyResponse(Message query) {
+        Message response = new Message(query.getHeader().getID());
+        response.getHeader().setFlag(Flags.QR);
+        response.addRecord(query.getQuestion(), Section.QUESTION);
+        return response;
+    }
+}
