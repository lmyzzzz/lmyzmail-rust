+        !reserve_image_pixels(probed_w, probed_h)) {
+        return nullptr;
+    }
+
+    int decoded_w = 0, decoded_h = 0, decoded_ch = 0;
+    uint8_t* px = stbi_load_from_memory(
+        data, len, &decoded_w, &decoded_h, &decoded_ch, 4);
+    if (!px) {
+        release_image_pixels(probed_w, probed_h);
+        return nullptr;
+    }
+    if (decoded_w != probed_w || decoded_h != probed_h) {
         stbi_image_free(px);
+        release_image_pixels(probed_w, probed_h);
         return nullptr;
