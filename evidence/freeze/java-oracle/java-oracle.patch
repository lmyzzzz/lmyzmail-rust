+package net.lmyz.lmyzmail.netty.smtp.codec;
+
+import io.netty.buffer.Unpooled;
+import io.netty.channel.embedded.EmbeddedChannel;
+import net.lmyz.lmyzmail.netty.smtp.SmtpServerConfiguration;
+import net.lmyz.lmyzmail.netty.smtp.session.SmtpExtension;
+import net.lmyz.lmyzmail.netty.smtp.session.SmtpSession;
+import net.lmyz.lmyzmail.netty.smtp.session.SmtpState;
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+class SmtpLineDecoderSecurityTest {
+
+    @Test
+    void unauthenticatedBdatDoesNotEnterBinaryDataMode() {
+        SmtpLineDecoder decoder = new SmtpLineDecoder(1000);
+        EmbeddedChannel channel = new EmbeddedChannel(decoder);
+
+        channel.writeInbound(Unpooled.copiedBuffer(
+                "BDAT 5 LAST\r\nabcde", StandardCharsets.US_ASCII));
+
+        Object first = channel.readInbound();
+        Object second = channel.readInbound();
+
+        assertThat(first).isInstanceOf(SmtpRequest.class);
+        assertThat(second).isNull();
+        assertThat(decoder.isInBdatMode()).isFalse();
+
+        channel.finishAndReleaseAll();
+    }
+
+    @Test
+    void validatedBdatTransactionStillAcceptsTheDeclaredChunk() {
+        SmtpLineDecoder decoder = new SmtpLineDecoder(1000);
+        EmbeddedChannel channel = new EmbeddedChannel(decoder);
+        SmtpServerConfiguration configuration = mock(SmtpServerConfiguration.class);
+        when(configuration.maxMessageSize()).thenReturn(1024L);
+
+        SmtpSession session = new SmtpSession(channel, configuration);
+        session.enableExtension(SmtpExtension.CHUNKING);
+        session.setState(SmtpState.RCPT);
+        session.setMailFrom("sender@example.com");
+        session.addRecipient("receiver@example.net");
+        channel.attr(SmtpLineDecoder.SMTP_SESSION).set(session);
+
+        channel.writeInbound(Unpooled.copiedBuffer(
+                "BDAT 5 LAST\r\nabcde", StandardCharsets.US_ASCII));
+
+        Object request = channel.readInbound();
+        assertThat(request).isInstanceOf(SmtpRequest.class);
+        Object data = channel.readInbound();
+        assertThat(data).isInstanceOf(BdatData.class);
+        BdatData bdatData = (BdatData) data;
+        assertThat(bdatData.readableBytes()).isEqualTo(5);
+        assertThat(bdatData.isLast()).isTrue();
+        bdatData.release();
+        channel.finishAndReleaseAll();
+    }
+}
