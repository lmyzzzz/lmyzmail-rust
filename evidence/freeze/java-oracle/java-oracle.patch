+
+    private void bufferWhileAuthorizationIsPending(ChannelHandlerContext ctx, Object msg) {
+        // HTTP/1.1 pipelining a second request while the first request is paused
+        // makes ownership and byte accounting ambiguous. Fail closed instead of
+        // allowing an unauthenticated message to reach the aggregator.
+        if (msg instanceof HttpRequest || !(msg instanceof HttpContent)) {
+            reject(ctx, msg, HttpResponseStatus.BAD_REQUEST);
+            return;
+        }
+        bufferPendingMessage(ctx, msg);
+    }
+
+    private boolean bufferPendingMessage(ChannelHandlerContext ctx, Object msg) {
+        if (pendingAuthorizationMessages.size() >= MAX_PENDING_AUTH_MESSAGES) {
+            reject(ctx, msg, HttpResponseStatus.SERVICE_UNAVAILABLE);
+            return false;
+        }
