+package net.lmyz.lmyzmail.web;
+
+import org.junit.jupiter.api.Test;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class WebMailFrontendSecurityTest {
+
+    @Test
+    void attachmentsUseAuthenticatedFetchInsteadOfSessionTokensInUrls() throws IOException {
+        String source = readIndexHtml();
+
+        assertThat(source)
+                .doesNotContain("?token=", "&token=")
+                .contains("downloadAttachment")
+                .contains("'X-Session-Token': token.value")
+                .contains("URL.createObjectURL");
+    }
+
+    @Test
+    void replyAndForwardHeadersAndPlainTextAreInsertedAsTextNodes() throws IOException {
+        String source = readIndexHtml();
+
+        assertThat(source)
+                .doesNotContain("在 ${data.date}，${data.from} 写道")
+                .doesNotContain("<p>发件人: ${data.from}</p>")
+                .doesNotContain("<p>主题: ${data.subject}</p>")
+                .contains("textContent")
+                .contains("data.text || ''");
+    }
+
+    @Test
+    void quotedMessageBuilderKeepsUntrustedMetadataAndPlainTextOutOfHtmlSinks()
+            throws IOException {
+        String source = readIndexHtml();
+        String quotedMessage = section(source,
+                "const setQuotedMessage =", "const closeCompose =");
+
+        assertThat(quotedMessage)
+                .contains("appendTextParagraph(quote, `")
+                .contains("${data.from || ''}", "${data.date || ''}", "${data.subject || ''}")
+                .contains("body.textContent = data.text || ''")
+                .contains("targetEditor.replaceChildren(")
+                .doesNotContain("targetEditor.innerHTML", "quote.innerHTML");
+    }
+
+    private static String section(String source, String startMarker, String endMarker) {
+        int start = source.indexOf(startMarker);
+        int end = source.indexOf(endMarker, start + startMarker.length());
+        assertThat(start).as("start marker %s", startMarker).isGreaterThanOrEqualTo(0);
+        assertThat(end).as("end marker %s", endMarker).isGreaterThan(start);
+        return source.substring(start, end);
+    }
+
+    private static String readIndexHtml() throws IOException {
+        try (InputStream input = WebMailFrontendSecurityTest.class
+                .getResourceAsStream("/static/index.html")) {
+            if (input == null) {
+                throw new IOException("Missing /static/index.html");
+            }
+            return new String(input.readAllBytes(), StandardCharsets.UTF_8);
+        }
+    }
+}
