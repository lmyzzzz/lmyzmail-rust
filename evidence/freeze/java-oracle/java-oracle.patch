+package net.lmyz.lmyzmail.inbound;
+
+import org.junit.jupiter.api.Test;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Collections;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.ArgumentMatchers.anyList;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+
+class SpamVerifierSecurityTest {
+
+    @Test
+    void dmarcUsesRfc5322FromDomainInsteadOfEnvelopeSenderDomain() {
+        TrackingSpamVerifierService service = new TrackingSpamVerifierService();
+        byte[] message = ("From: Administrator <admin@victim.example>\r\n" +
+                "To: user@local.example\r\n" +
+                "Subject: alignment regression\r\n" +
+                "\r\n" +
+                "body\r\n").getBytes(StandardCharsets.US_ASCII);
+
+        SpamVerifierService.VerificationResult result = service.verifyFromBytes(
+                "203.0.113.10",
+                "mail.attacker.example",
+                "bounce@attacker.example",
+                message,
+                new SpamVerifierService.SpfCheckResult("pass", "attacker SPF passed"),
+                null
+        );
+
+        assertThat(service.lastDmarcLookupDomain).isEqualTo("victim.example");
+        assertThat(result.dmarcPolicy()).isEqualTo("reject");
+        assertThat(result.dmarcResult()).isEqualTo("fail");
+    }
+
+    @Test
+    void strictSpfAlignmentRejectsPassingButNonIdenticalEnvelopeDomain() {
+        TrackingSpamVerifierService service = new TrackingSpamVerifierService();
+        service.dmarcRecord = SpamVerifierService.DmarcRecord.parse(
+                "v=DMARC1; p=reject; aspf=s; adkim=s");
+
+        byte[] message = ("From: user@example.com\r\n" +
+                "To: receiver@local.example\r\n" +
+                "\r\n" +
+                "body\r\n").getBytes(StandardCharsets.US_ASCII);
+
+        SpamVerifierService.VerificationResult result = service.verifyFromBytes(
+                "203.0.113.10",
+                "mail.example.com",
+                "bounce@mail.example.com",
+                message,
+                new SpamVerifierService.SpfCheckResult("pass", "SPF passed"),
+                null
+        );
+
+        assertThat(result.dmarcResult()).isEqualTo("fail");
+    }
+
+    @Test
+    void spfEvaluationStopsAtGlobalTenDnsTermBudget() {
+        ParallelDnsQueryService parallelDns = mock(ParallelDnsQueryService.class);
+        when(parallelDns.parallelLookupSpfIncludes(anyList()))
+                .thenReturn(Collections.nCopies(11, "v=spf1 -all"));
+
+        SpamVerifierService service = new SpamVerifierService(parallelDns, null, null, null);
+        String record = "v=spf1 " +
+                java.util.stream.IntStream.rangeClosed(1, 11)
+                        .mapToObj(i -> "include:i" + i + ".example")
+                        .collect(java.util.stream.Collectors.joining(" ")) +
+                " -all";
+
+        SpamVerifierService.SpfCheckResult result = service.verifySPFWithRecord(
+                "203.0.113.10", "sender@example.com", record);
+
+        assertThat(result.result()).isEqualTo("permerror");
+        assertThat(result.reason()).containsIgnoringCase("DNS").contains("10");
+        verifyNoInteractions(parallelDns);
+    }
+
+    @Test
+    void dmarcVersionTagMustMatchExactly() {
+        assertThat(SpamVerifierService.DmarcRecord.parse(
+                "v=DMARC1; p=reject")).isNotNull();
+        assertThat(SpamVerifierService.DmarcRecord.parse(
+                "v=DMARC1evil; p=reject")).isNull();
+    }
+
+    private static final class TrackingSpamVerifierService extends SpamVerifierService {
+        private String lastDmarcLookupDomain;
+        private SpamVerifierService.DmarcRecord dmarcRecord =
+                SpamVerifierService.DmarcRecord.parse("v=DMARC1; p=reject");
+
+        private TrackingSpamVerifierService() {
+            super(null, null, null, null);
+        }
+
+        @Override
+        public SpamVerifierService.DmarcRecord lookupDmarcRecord(String domain) {
+            lastDmarcLookupDomain = domain;
+            return dmarcRecord;
+        }
+    }
+}
