+++ b/benchmarks/results/README.md
@@ -0,0 +1,6 @@
+# Raw benchmark results
+
+Keep timestamped, host-specific benchmark output here. A reportable result must
+include the environment lines, all nine or more runs, summaries, and final
+checksum. `PERFORMANCE_RESULTS.md` records the interpretation and keep/revert
+decision for each optimization hypothesis.
diff --git a/benchmarks/run-benchmark.sh b/benchmarks/run-benchmark.sh
new file mode 100644
index 0000000..842b78a
--- /dev/null
+++ b/benchmarks/run-benchmark.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+mode="${MODE:-avx2}"
+cc="${CC:-gcc}"
+output_dir="$repo_dir/build/benchmarks"
+binary="$output_dir/skibidi-benchmark-$mode"
+
+case "$mode" in
+    avx2)
+        arch_flags=(-march=native -mavx2)
+        ;;
+    scalar)
+        arch_flags=(-mno-avx -mno-avx2)
+        ;;
+    *)
+        echo "MODE must be avx2 or scalar" >&2
+        exit 2
+        ;;
+esac
+
+common_flags=(-O3 -std=gnu11 -Wall -Wextra -Werror -fno-omit-frame-pointer)
+read -r -a extra_cflags <<< "${EXTRA_CFLAGS:-}"
+mkdir -p "$output_dir"
+
+echo "ENV timestamp_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+echo "ENV cpu_model=$(awk -F: '/model name/ {gsub(/^[[:space:]]+/, "", $2); print $2; exit}' /proc/cpuinfo)"
+echo "ENV kernel=$(uname -srvmo)"
+echo "ENV wsl=$(grep -qi microsoft /proc/version && echo yes || echo no)"
+echo "ENV compiler=$($cc --version | head -n 1)"
+echo "ENV mode=$mode flags=${common_flags[*]} ${arch_flags[*]} ${extra_cflags[*]}"
+echo "ENV affinity_before=$(taskset -pc $$ 2>&1 | tr '\n' ' ')"
+
+if compgen -G '/sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq' >/dev/null; then
+    echo "ENV cpufreq=available"
+else
+    echo "ENV cpufreq=unavailable"
+fi
+if compgen -G '/sys/class/thermal/thermal_zone*/temp' >/dev/null; then
+    echo "ENV thermal=available"
+else
+    echo "ENV thermal=unavailable"
+fi
+if grep -qiE 'thermal thrott|temperature above threshold|cpu.*throttl' \
+    /var/log/kern.log 2>/dev/null; then
+    echo "ENV kernel_throttle_log=present-review-required"
+else
+    echo "ENV kernel_throttle_log=not-observed-or-unavailable"
+fi
+
+"$cc" "${common_flags[@]}" "${arch_flags[@]}" "${extra_cflags[@]}" \
+    -I"$repo_dir" \
+    "$repo_dir/benchmarks/skibidi_benchmark.c" \
+    "$repo_dir/skibidi_avx.c" \
+    -pthread -lm -o "$binary"
+
+echo "ENV binary=$binary"
+exec "$binary" "$@"
diff --git a/benchmarks/run-reportable.ps1 b/benchmarks/run-reportable.ps1
new file mode 100644
index 0000000..963511e
--- /dev/null
+++ b/benchmarks/run-reportable.ps1
@@ -0,0 +1,96 @@
+[CmdletBinding()]
+param(
+    [ValidateSet('avx2', 'scalar')]
+    [string]$Mode = 'avx2',
+    [ValidateSet('gcc', 'clang')]
+    [string]$Compiler = 'gcc',
+    [int]$Cpu = 10,
+    [int]$DurationMs = 1000,
+    [int]$DramMiB = 256,
+    [string]$ExtraCFlags = '',
+    [string[]]$Cases = @(),
+    [string]$OutputBase
+)
+
+$ErrorActionPreference = 'Stop'
+$repoDir = Split-Path -Parent $PSScriptRoot
+$timestamp = Get-Date -Format 'yyyy-MM-dd-HHmmss'
+if (-not $OutputBase) {
+    $OutputBase = Join-Path $PSScriptRoot "results/$timestamp-$Mode-cpu$Cpu"
+}
+$resultPath = "$OutputBase.txt"
+$telemetryPath = "$OutputBase-windows-telemetry.csv"
+
+if ($Cases.Count -eq 0) {
+    $Cases = if ($Mode -eq 'avx2') {
+        @('batch-l1', 'batch-l2', 'batch-dram')
+    } else {
+        @('scalar-generate-l1', 'scalar-variant-l1')
+    }
+}
+
+$counterPaths = @(
+    "\Processor Information(0,$Cpu)\Actual Frequency",
+    "\Processor Information(0,$Cpu)\% Processor Performance",
+    "\Processor Information(0,$Cpu)\% of Maximum Frequency",
+    "\Processor Information(0,$Cpu)\% Performance Limit",
+    "\Processor Information(0,$Cpu)\Performance Limit Flags"
+)
+
+$counterJob = Start-Job -ArgumentList (,$counterPaths) -ScriptBlock {
+    param([string[]]$Paths)
+    Get-Counter -Counter $Paths -SampleInterval 1 -Continuous | ForEach-Object {
+        $timestamp = $_.Timestamp
+        foreach ($sample in $_.CounterSamples) {
+            [pscustomobject]@{
+                Timestamp = $timestamp
+                Path = $sample.Path
+                CookedValue = $sample.CookedValue
+            }
+        }
+    }
+}
+
+$wslArguments = @(
+    'env', "MODE=$Mode", "CC=$Compiler", "EXTRA_CFLAGS=$ExtraCFlags",
+    'bash', 'benchmarks/run-benchmark.sh',
+    '--cpu', "$Cpu", '--runs', '9', '--duration-ms', "$DurationMs",
+    '--dram-mib', "$DramMiB"
+)
+foreach ($caseName in $Cases) {
+    $wslArguments += @('--case', $caseName)
+}
+
+try {
+    Push-Location $repoDir
+    try {
+        & wsl.exe @wslArguments 2>&1 | Tee-Object -FilePath $resultPath
+        if ($LASTEXITCODE -ne 0) {
+            throw "WSL benchmark exited with code $LASTEXITCODE."
+        }
+    } finally {
+        Pop-Location
+    }
+} finally {
+    Stop-Job $counterJob -ErrorAction SilentlyContinue
+    $counterSets = Receive-Job $counterJob -ErrorAction SilentlyContinue
+    Remove-Job $counterJob -Force -ErrorAction SilentlyContinue
+}
+
+$telemetry = foreach ($sample in $counterSets) {
+    $sampleTimestamp = if ($sample.Timestamp) { $sample.Timestamp } else { Get-Date }
+    [pscustomobject]@{
+        Timestamp = $sampleTimestamp.ToUniversalTime().ToString('o')
+        Path = $sample.Path
+        CookedValue = $sample.CookedValue
+    }
+}
+$telemetry | Export-Csv -LiteralPath $telemetryPath -NoTypeInformation -Encoding UTF8
+
+$temperature = Get-CimInstance -Namespace root/wmi -ClassName MSAcpi_ThermalZoneTemperature `
+    -ErrorAction SilentlyContinue
+Write-Output "RESULT benchmark=$resultPath"
+Write-Output "RESULT windows_telemetry=$telemetryPath"
+Write-Output "RESULT acpi_temperature=$(
+    if ($temperature) { 'available' } else { 'unavailable' }
+)"
diff --git a/benchmarks/skibidi_benchmark.c b/benchmarks/skibidi_benchmark.c
new file mode 100644
index 0000000..b819f55
--- /dev/null
+++ b/benchmarks/skibidi_benchmark.c
@@ -0,0 +1,848 @@
+#define _GNU_SOURCE
+
+#include "skibidi_avx.h"
+
+#include <cpuid.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <linux/perf_event.h>
+#include <math.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/syscall.h>
+#include <sys/utsname.h>
+#include <time.h>
+#include <unistd.h>
+
+#ifdef __AVX2__
+#include <immintrin.h>
+#endif
+
+#define BENCH_RECORD_CAPACITY 44u
+#define DEFAULT_RUNS 9
+#define DEFAULT_DURATION_MS 1000u
+#define DEFAULT_DRAM_MIB 256u
+#define L1_BATCH_COUNT 64u
+#define L1_SLOT_COUNT 8u
+#define L2_SLOT_COUNT 85u
+#define DRAM_BATCH_COUNT 1024u
+#define PERF_EVENT_COUNT 5
+
+typedef enum {
+    CASE_SCALAR_GENERATE_L1,
+    CASE_SCALAR_VARIANT_L1,
+    CASE_BATCH_L1,
+    CASE_BATCH_L2,
+    CASE_BATCH_DRAM,
+    CASE_CONTROL_RNG_L1,
+    CASE_CONTROL_STORE_L1,
+    CASE_COUNT
+} CaseId;
+
+typedef struct {
+    const char* name;
+    CaseId id;
+    uint32_t batch_count;
+    size_t slot_count;
+    size_t output_stride;
+    size_t lengths_stride;
+    size_t total_bytes;
+    unsigned char* output;
+    int* lengths;
+} Workload;
+
+typedef struct {
+    const char* name;
+    uint64_t config;
+    int fd;
+} PerfEvent;
+
+typedef struct {
+    PerfEvent events[PERF_EVENT_COUNT];
+    int available;
+    int error_number;
+} PerfGroup;
+
+typedef struct {
+    uint64_t value;
+    uint64_t time_enabled;
+    uint64_t time_running;
+} PerfRead;
+
+typedef struct {
+    double wall_seconds;
+    double throughput;
+    double latency_ns;
+    double tsc_cycles_per_op;
+    double core_cycles_per_op;
+    double instructions_per_op;
+    double branches_per_op;
+    double branch_misses_per_kop;
+    double cache_misses_per_kop;
+    double effective_gbps;
+    uint64_t operations;
+    uint64_t tsc_cycles;
+    uint64_t checksum;
+    int perf_available;
+} Sample;
+
+typedef struct {
+    int cpu;
+    int runs;
+    uint64_t duration_ns;
+    size_t dram_bytes;
+    uint32_t selected_cases;
+    int quick_mode;
+} Options;
+
+static volatile uint64_t checksum_sink;
+
+static void usage(const char* program) {
+    fprintf(stderr,
+            "usage: %s [--cpu N] [--runs N] [--duration-ms N] "
+            "[--dram-mib N] [--case NAME] [--quick]\n"
+            "cases: scalar-generate-l1, scalar-variant-l1, batch-l1, "
+            "batch-l2, batch-dram, control-rng-l1, control-store-l1, all\n",
+            program);
+}
+
+static uint64_t parse_u64(const char* text, const char* option) {
+    char* end = NULL;
+    errno = 0;
+    unsigned long long value = strtoull(text, &end, 10);
+    if (errno || !end || *end != '\0') {
+        fprintf(stderr, "invalid value for %s: %s\n", option, text);
+        exit(2);
+    }
+    return (uint64_t)value;
+}
+
+static uint32_t case_bit(CaseId id) {
+    return UINT32_C(1) << (unsigned)id;
+}
+
+static int parse_case(const char* name, uint32_t* selected) {
+    static const struct {
+        const char* name;
+        CaseId id;
+    } cases[] = {
+        {"scalar-generate-l1", CASE_SCALAR_GENERATE_L1},
+        {"scalar-variant-l1", CASE_SCALAR_VARIANT_L1},
+        {"batch-l1", CASE_BATCH_L1},
+        {"batch-l2", CASE_BATCH_L2},
+        {"batch-dram", CASE_BATCH_DRAM},
+        {"control-rng-l1", CASE_CONTROL_RNG_L1},
+        {"control-store-l1", CASE_CONTROL_STORE_L1},
+    };
+
+    if (strcmp(name, "all") == 0) {
+        *selected = (UINT32_C(1) << CASE_COUNT) - 1;
+        return 0;
+    }
+    for (size_t i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        if (strcmp(name, cases[i].name) == 0) {
+            *selected |= case_bit(cases[i].id);
+            return 0;
+        }
+    }
+    return -1;
+}
+
+static Options parse_options(int argc, char** argv) {
+    Options options = {
+        .cpu = 0,
+        .runs = DEFAULT_RUNS,
+        .duration_ns = (uint64_t)DEFAULT_DURATION_MS * UINT64_C(1000000),
+        .dram_bytes = (size_t)DEFAULT_DRAM_MIB << 20,
+        .selected_cases = 0,
+        .quick_mode = 0,
+    };
+
+    for (int i = 1; i < argc; i++) {
+        if (strcmp(argv[i], "--cpu") == 0 && i + 1 < argc) {
+            options.cpu = (int)parse_u64(argv[++i], "--cpu");
+        } else if (strcmp(argv[i], "--runs") == 0 && i + 1 < argc) {
+            options.runs = (int)parse_u64(argv[++i], "--runs");
+        } else if (strcmp(argv[i], "--duration-ms") == 0 && i + 1 < argc) {
+            options.duration_ns = parse_u64(argv[++i], "--duration-ms") * 1000000;
+        } else if (strcmp(argv[i], "--dram-mib") == 0 && i + 1 < argc) {
+            options.dram_bytes = (size_t)parse_u64(argv[++i], "--dram-mib") << 20;
+        } else if (strcmp(argv[i], "--case") == 0 && i + 1 < argc) {
+            if (parse_case(argv[++i], &options.selected_cases) != 0) {
+                fprintf(stderr, "unknown case: %s\n", argv[i]);
+                exit(2);
+            }
+        } else if (strcmp(argv[i], "--quick") == 0) {
+            options.quick_mode = 1;
+        } else if (strcmp(argv[i], "--help") == 0) {
+            usage(argv[0]);
+            exit(0);
+        } else {
+            usage(argv[0]);
+            exit(2);
+        }
+    }
+
+    if (options.selected_cases == 0) {
+        options.selected_cases = (UINT32_C(1) << CASE_COUNT) - 1;
+    }
+    if (options.quick_mode) {
+        if (options.runs == DEFAULT_RUNS) options.runs = 3;
+        if (options.duration_ns ==
+            (uint64_t)DEFAULT_DURATION_MS * UINT64_C(1000000)) {
+            options.duration_ns = UINT64_C(150) * 1000000;
+        }
+        if (options.dram_bytes == ((size_t)DEFAULT_DRAM_MIB << 20)) {
+            options.dram_bytes = (size_t)64 << 20;
+        }
+    } else if (options.runs < 9) {
+        fprintf(stderr, "reportable runs require --runs >= 9 (or use --quick)\n");
+        exit(2);
+    }
+    if (options.runs < 1 || options.duration_ns == 0 || options.dram_bytes < (64u << 20)) {
+        fprintf(stderr, "runs, duration, and DRAM workset must be positive; DRAM >= 64 MiB\n");
+        exit(2);
+    }
+    return options;
+}
+
+static void pin_to_cpu(int cpu) {
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    CPU_SET(cpu, &set);
+    if (sched_setaffinity(0, sizeof(set), &set) != 0) {
+        fprintf(stderr, "sched_setaffinity(cpu=%d) failed: %s\n", cpu, strerror(errno));
+        exit(1);
+    }
+    if (sched_getcpu() != cpu) {
+        fprintf(stderr, "affinity verification failed: requested=%d observed=%d\n",
+                cpu, sched_getcpu());
+        exit(1);
+    }
+}
+
+static uint64_t monotonic_ns(void) {
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC_RAW, &ts) != 0) {
+        perror("clock_gettime");
+        exit(1);
+    }
+    return (uint64_t)ts.tv_sec * UINT64_C(1000000000) + (uint64_t)ts.tv_nsec;
+}
+
+static inline uint64_t serialized_tsc_start(void) {
+    uint32_t lo;
+    uint32_t hi;
+    __asm__ __volatile__("lfence\n\trdtsc" : "=a"(lo), "=d"(hi) : : "memory");
+    return ((uint64_t)hi << 32) | lo;
+}
+
+static inline uint64_t serialized_tsc_end(void) {
+    uint32_t lo;
+    uint32_t hi;
+    uint32_t aux;
+    __asm__ __volatile__("rdtscp\n\tlfence"
+                         : "=a"(lo), "=d"(hi), "=c"(aux)
+                         :
+                         : "memory");
+    return ((uint64_t)hi << 32) | lo;
+}
+
+static inline void output_barrier(const void* output, const void* lengths) {
+    __asm__ __volatile__("" : : "r"(output), "r"(lengths) : "memory");
+}
+
+static size_t align_up(size_t value, size_t alignment) {
+    return (value + alignment - 1) & ~(alignment - 1);
+}
+
+static void* alloc_aligned(size_t alignment, size_t bytes) {
+    void* result = NULL;
+    if (posix_memalign(&result, alignment, bytes) != 0) return NULL;
+    return result;
+}
+
+static const char* case_name(CaseId id) {
+    static const char* names[CASE_COUNT] = {
+        "scalar-generate-l1",
+        "scalar-variant-l1",
+        "batch-l1",
+        "batch-l2",
+        "batch-dram",
+        "control-rng-l1",
+        "control-store-l1",
+    };
+    return names[id];
+}
+
+static int is_batch_case(CaseId id) {
+    return id == CASE_BATCH_L1 || id == CASE_BATCH_L2 || id == CASE_BATCH_DRAM;
+}
+
+static int is_control_case(CaseId id) {
+    return id == CASE_CONTROL_RNG_L1 || id == CASE_CONTROL_STORE_L1;
+}
+
+static Workload make_workload(CaseId id, size_t dram_bytes) {
+    Workload workload = {.name = case_name(id), .id = id};
+    if (id == CASE_CONTROL_RNG_L1) {
+        workload.batch_count = L1_BATCH_COUNT;
+        workload.slot_count = 1;
+        workload.output_stride = SKIBIDI_MIN_BUFFER_SIZE;
+        workload.lengths_stride = 0;
+    } else if (id == CASE_CONTROL_STORE_L1) {
+        workload.batch_count = L1_BATCH_COUNT;
+        workload.slot_count = L1_SLOT_COUNT;
+        workload.output_stride = L1_BATCH_COUNT * 32u;
+        workload.lengths_stride = L1_BATCH_COUNT * sizeof(*workload.lengths);
+    } else if (!is_batch_case(id)) {
+        workload.batch_count = 1;
+        workload.slot_count = 1;
+        workload.output_stride = SKIBIDI_MIN_BUFFER_SIZE;
+        workload.lengths_stride = 0;
+    } else {
+        workload.batch_count = id == CASE_BATCH_DRAM ? DRAM_BATCH_COUNT : L1_BATCH_COUNT;
+        workload.output_stride = align_up(
+            (size_t)workload.batch_count * BENCH_RECORD_CAPACITY, 64);
+        workload.lengths_stride = align_up(
+            (size_t)workload.batch_count * sizeof(*workload.lengths), 64);
+        if (id == CASE_BATCH_L1) {
+            workload.slot_count = L1_SLOT_COUNT;
+        } else if (id == CASE_BATCH_L2) {
+            workload.slot_count = L2_SLOT_COUNT;
+        } else {
+            size_t bytes_per_slot = workload.output_stride + workload.lengths_stride;
+            workload.slot_count = dram_bytes / bytes_per_slot;
+            if (workload.slot_count == 0) workload.slot_count = 1;
+        }
+    }
+
+    size_t output_bytes = workload.slot_count * workload.output_stride;
+    size_t lengths_bytes = workload.slot_count * workload.lengths_stride;
+    workload.total_bytes = output_bytes + lengths_bytes;
+    workload.output = alloc_aligned(64, output_bytes);
+    workload.lengths = lengths_bytes ? alloc_aligned(64, lengths_bytes) : NULL;
+    if (!workload.output || (lengths_bytes && !workload.lengths)) {
+        fprintf(stderr, "allocation failed for %s (%zu bytes)\n",
+                workload.name, workload.total_bytes);
+        exit(1);
+    }
+    memset(workload.output, 0xa5, output_bytes);
+    if (lengths_bytes) memset(workload.lengths, 0x5a, lengths_bytes);
+    return workload;
+}
+
+static void free_workload(Workload* workload) {
+    free(workload->lengths);
+    free(workload->output);
+    memset(workload, 0, sizeof(*workload));
+}
+
+static long perf_event_open(struct perf_event_attr* attr, int group_fd) {
+    return syscall(SYS_perf_event_open, attr, 0, -1, group_fd, 0);
+}
+
+static PerfGroup perf_group_open(void) {
+    PerfGroup group = {
+        .events = {
+            {"core_cycles", PERF_COUNT_HW_CPU_CYCLES, -1},
+            {"instructions", PERF_COUNT_HW_INSTRUCTIONS, -1},
+            {"branches", PERF_COUNT_HW_BRANCH_INSTRUCTIONS, -1},
+            {"branch_misses", PERF_COUNT_HW_BRANCH_MISSES, -1},
+            {"cache_misses", PERF_COUNT_HW_CACHE_MISSES, -1},
+        },
+        .available = 1,
+        .error_number = 0,
+    };
+
+    for (int i = 0; i < PERF_EVENT_COUNT; i++) {
+        struct perf_event_attr attr;
+        memset(&attr, 0, sizeof(attr));
+        attr.type = PERF_TYPE_HARDWARE;
+        attr.size = sizeof(attr);
+        attr.config = group.events[i].config;
+        attr.disabled = 1;
+        attr.exclude_kernel = 1;
+        attr.exclude_hv = 1;
+        attr.read_format = PERF_FORMAT_TOTAL_TIME_ENABLED |
+                           PERF_FORMAT_TOTAL_TIME_RUNNING;
+        group.events[i].fd = (int)perf_event_open(&attr, -1);
+        if (group.events[i].fd < 0) {
+            group.available = 0;
+            group.error_number = errno;
+            break;
+        }
+    }
+    if (!group.available) {
+        for (int i = 0; i < PERF_EVENT_COUNT; i++) {
+            if (group.events[i].fd >= 0) close(group.events[i].fd);
+            group.events[i].fd = -1;
+        }
+    }
+    return group;
+}
+
+static void perf_group_reset_enable(PerfGroup* group) {
+    if (!group->available) return;
+    for (int i = 0; i < PERF_EVENT_COUNT; i++) {
+        ioctl(group->events[i].fd, PERF_EVENT_IOC_RESET, 0);
+        ioctl(group->events[i].fd, PERF_EVENT_IOC_ENABLE, 0);
+    }
+}
+
+static void perf_group_disable(PerfGroup* group) {
+    if (!group->available) return;
+    for (int i = 0; i < PERF_EVENT_COUNT; i++) {
+        ioctl(group->events[i].fd, PERF_EVENT_IOC_DISABLE, 0);
+    }
+}
+
+static double perf_read_scaled(const PerfEvent* event) {
+    PerfRead readout;
+    ssize_t bytes = read(event->fd, &readout, sizeof(readout));
+    if (bytes != (ssize_t)sizeof(readout) || readout.time_running == 0) return NAN;
+    return (double)readout.value *
+           ((double)readout.time_enabled / (double)readout.time_running);
+}
+
+static void perf_group_close(PerfGroup* group) {
+    for (int i = 0; i < PERF_EVENT_COUNT; i++) {
+        if (group->events[i].fd >= 0) close(group->events[i].fd);
+        group->events[i].fd = -1;
+    }
+}
+
+#ifdef __AVX2__
+static inline __m256i control_rotate_left_64(
+    __m256i value, int left, int right)
+{
+    return _mm256_or_si256(
+        _mm256_slli_epi64(value, left),
+        _mm256_srli_epi64(value, right));
+}
+
+static inline __m256i control_rng_advance(__m256i* s0, __m256i* s1) {
+    const __m256i old_s0 = *s0;
+    __m256i mixed_s1 = _mm256_xor_si256(*s1, old_s0);
+    const __m256i sum = _mm256_add_epi64(old_s0, *s1);
+    const __m256i result = _mm256_add_epi64(
+        control_rotate_left_64(sum, 17, 47), old_s0);
+    *s0 = _mm256_xor_si256(
+        _mm256_xor_si256(
+            control_rotate_left_64(old_s0, 49, 15), mixed_s1),
+        _mm256_slli_epi64(mixed_s1, 21));
+    *s1 = control_rotate_left_64(mixed_s1, 28, 36);
+    return result;
+}
+
+static uint64_t run_rng_control(
+    Workload* workload, SkibidiContext* context, uint64_t calls)
+{
+    __m256i accumulator = _mm256_load_si256((const __m256i*)workload->output);
+    uint64_t operations = 0;
+    for (uint64_t call = 0; call < calls; call++) {
+        __m256i s0 = _mm256_load_si256((const __m256i*)context->rng.s0);
+        __m256i s1 = _mm256_load_si256((const __m256i*)context->rng.s1);
+        for (uint32_t group = 0; group < L1_BATCH_COUNT / 4; group++) {
+            const __m256i entropy1 = control_rng_advance(&s0, &s1);
+            const __m256i entropy2 = control_rng_advance(&s0, &s1);
+            accumulator = _mm256_xor_si256(
+                accumulator, _mm256_xor_si256(entropy1, entropy2));
+        }
+        _mm256_store_si256((__m256i*)context->rng.s0, s0);
+        _mm256_store_si256((__m256i*)context->rng.s1, s1);
+        _mm256_store_si256((__m256i*)workload->output, accumulator);
+        context->call_count += L1_BATCH_COUNT;
+        operations += L1_BATCH_COUNT;
+        output_barrier(workload->output, context);
+    }
+    return operations;
+}
+
+static const unsigned char CONTROL_RECORD[32] __attribute__((aligned(32))) =
+    "Skibidi dop dop dop yes yes!";
+
+static uint64_t run_store_control(
+    Workload* workload, SkibidiContext* context,
+    uint64_t calls, uint64_t start_slot)
+{
+    const __m256i record = _mm256_load_si256((const __m256i*)CONTROL_RECORD);
+    uint64_t operations = 0;
+    for (uint64_t call = 0; call < calls; call++) {
+        const size_t slot = (size_t)((start_slot + call) % workload->slot_count);
+        unsigned char* output =
+            workload->output + slot * workload->output_stride;
+        int* lengths = (int*)((unsigned char*)workload->lengths +
+                              slot * workload->lengths_stride);
+        for (uint32_t i = 0; i < L1_BATCH_COUNT; i++) {
+            _mm256_storeu_si256((__m256i*)(output + (size_t)i * 32), record);
+            output[(size_t)i * 32 + 28] = '\n';
+            lengths[i] = 28;
+        }
+        context->call_count += L1_BATCH_COUNT;
+        operations += L1_BATCH_COUNT;
+        output_barrier(output, lengths);
+    }
+    return operations;
+}
+#endif
+
+static uint64_t run_calls(Workload* workload, SkibidiContext* context,
+                          uint64_t calls, uint64_t start_slot) {
+#ifdef __AVX2__
+    if (workload->id == CASE_CONTROL_RNG_L1) {
+        return run_rng_control(workload, context, calls);
+    }
+    if (workload->id == CASE_CONTROL_STORE_L1) {
+        return run_store_control(workload, context, calls, start_slot);
+    }
+#else
+    if (is_control_case(workload->id)) {
+        fprintf(stderr, "%s requires an AVX2 build\n", workload->name);
+        exit(1);
+    }
+#endif
+    uint64_t operations = 0;
+    for (uint64_t call = 0; call < calls; call++) {
+        size_t slot = (size_t)((start_slot + call) % workload->slot_count);
+        unsigned char* output = workload->output + slot * workload->output_stride;
+        if (!is_batch_case(workload->id)) {
+            int length = workload->id == CASE_SCALAR_VARIANT_L1
+                             ? skibidi_generate_variant(context, (char*)output,
+                                                        workload->output_stride)
+                             : skibidi_generate(context, (char*)output,
+                                                workload->output_stride);
+            if (length < 0) {
+                fprintf(stderr, "%s failed with %d\n", workload->name, length);
+                exit(1);
+            }
+            operations++;
+            output_barrier(output, context);
+        } else {
+            int* lengths = (int*)((unsigned char*)workload->lengths +
+                                  slot * workload->lengths_stride);
+            int generated = skibidi_generate_batch(
+                context, (char*)output, workload->output_stride,
+                (int)workload->batch_count, lengths);
+            if (generated != (int)workload->batch_count) {
+                fprintf(stderr, "%s generated %d/%u records\n",
+                        workload->name, generated, workload->batch_count);
+                exit(1);
+            }
+            operations += (uint64_t)generated;
+            output_barrier(output, lengths);
+        }
+    }
+    return operations;
+}
+
+static uint64_t checksum_bytes(uint64_t hash, const void* data, size_t length) {
+    const unsigned char* bytes = data;
+    for (size_t i = 0; i < length; i++) {
+        hash ^= bytes[i];
+        hash *= UINT64_C(1099511628211);
+    }
+    return hash;
+}
+
+static uint64_t checksum_after_run(const Workload* workload,
+                                   const SkibidiContext* context) {
+    uint64_t hash = UINT64_C(1469598103934665603);
+    hash = checksum_bytes(hash, workload->output,
+                          workload->slot_count * workload->output_stride);
+    if (workload->lengths) {
+        hash = checksum_bytes(hash, workload->lengths,
+                              workload->slot_count * workload->lengths_stride);
+    }
+    hash = checksum_bytes(hash, &context->rng, sizeof(context->rng));
+    hash = checksum_bytes(hash, &context->call_count, sizeof(context->call_count));
+    checksum_sink ^= hash;
+    return hash;
+}
+
+static double estimate_bytes_per_op(const Workload* workload) {
+    if (workload->id == CASE_CONTROL_RNG_L1) return 0.0;
+    if (workload->id == CASE_CONTROL_STORE_L1) return 37.0;
+    SkibidiContext context;
+    if (skibidi_init(&context, UINT64_C(0xd1b54a32d192ed03)) != SKIBIDI_OK) exit(1);
+    uint64_t bytes = 0;
+    const uint64_t target_operations = UINT64_C(1000000);
+    if (!is_batch_case(workload->id)) {
+        unsigned char output[SKIBIDI_MIN_BUFFER_SIZE];
+        for (uint64_t i = 0; i < target_operations; i++) {
+            int length = workload->id == CASE_SCALAR_VARIANT_L1
+                             ? skibidi_generate_variant(&context, (char*)output, sizeof(output))
+                             : skibidi_generate(&context, (char*)output, sizeof(output));
+            bytes += (uint64_t)length;
+        }
+    } else {
+        const uint32_t count = workload->batch_count;
+        unsigned char* output = alloc_aligned(64, workload->output_stride);
+        int* lengths = alloc_aligned(64, workload->lengths_stride);
+        uint64_t operations = 0;
+        while (operations < target_operations) {
+            int generated = skibidi_generate_batch(
+                &context, (char*)output, workload->output_stride, (int)count, lengths);
+            for (int i = 0; i < generated; i++) bytes += (uint64_t)lengths[i] + 1;
+            operations += (uint64_t)generated;
+        }
+        free(lengths);
+        free(output);
+        return (double)bytes / (double)operations;
+    }
+    return (double)bytes / (double)target_operations;
+}
+
+static uint64_t calibrated_calls(Workload* workload, uint64_t target_ns) {
+    uint64_t calls =
+        (is_batch_case(workload->id) || is_control_case(workload->id))
+            ? 256
+            : 65536;
+    if (workload->id == CASE_BATCH_DRAM && calls < workload->slot_count) {
+        calls = workload->slot_count;
+    }
+    for (;;) {
+        SkibidiContext context;
+        skibidi_init(&context, UINT64_C(0x94d049bb133111eb));
+        uint64_t start = monotonic_ns();
+        run_calls(workload, &context, calls, 0);
+        uint64_t elapsed = monotonic_ns() - start;
+        if (elapsed >= UINT64_C(100000000)) {
+            long double scaled = (long double)calls * (long double)target_ns /
+                                 (long double)elapsed;
+            uint64_t result = (uint64_t)ceill(scaled);
+            if (result < 1) result = 1;
+            if (workload->id == CASE_BATCH_DRAM) {
+                uint64_t slots = (uint64_t)workload->slot_count;
+                result = ((result + slots - 1) / slots) * slots;
+            }
+            return result;
+        }
+        if (calls > UINT64_MAX / 2) return calls;
+        calls *= 2;
+    }
+}
+
+static void warm_workload(Workload* workload) {
+    SkibidiContext context;
+    skibidi_init(&context, UINT64_C(0x9e3779b97f4a7c15));
+    uint64_t warm_calls;
+    if (workload->id == CASE_BATCH_DRAM) {
+        warm_calls = workload->slot_count;
+    } else if (is_batch_case(workload->id) || is_control_case(workload->id)) {
+        warm_calls = 4096;
+    } else {
+        warm_calls = 250000;
+    }
+    run_calls(workload, &context, warm_calls, 0);
+}
+
+static Sample measure_sample(Workload* workload, uint64_t calls, int run_index,
+                             double bytes_per_op, PerfGroup* perf) {
+    SkibidiContext context;
+    uint64_t seed = UINT64_C(0x243f6a8885a308d3) ^
+                    ((uint64_t)(unsigned)run_index * UINT64_C(0x9e3779b97f4a7c15));
+    skibidi_init(&context, seed);
+
+    perf_group_reset_enable(perf);
+    uint64_t wall_start = monotonic_ns();
+    uint64_t tsc_start = serialized_tsc_start();
+    uint64_t operations = run_calls(workload, &context, calls,
+                                    (uint64_t)run_index * 17);
+    uint64_t tsc_end = serialized_tsc_end();
+    uint64_t wall_end = monotonic_ns();
+    perf_group_disable(perf);
+
+    double seconds = (double)(wall_end - wall_start) / 1e9;
+    Sample sample = {
+        .wall_seconds = seconds,
+        .throughput = (double)operations / seconds,
+        .latency_ns = seconds * 1e9 / (double)operations,
+        .tsc_cycles_per_op = (double)(tsc_end - tsc_start) / (double)operations,
+        .core_cycles_per_op = NAN,
+        .instructions_per_op = NAN,
+        .branches_per_op = NAN,
+        .branch_misses_per_kop = NAN,
+        .cache_misses_per_kop = NAN,
+        .effective_gbps = ((double)operations / seconds) * bytes_per_op / 1e9,
+        .operations = operations,
+        .tsc_cycles = tsc_end - tsc_start,
+        .checksum = checksum_after_run(workload, &context),
+        .perf_available = perf->available,
+    };
+
+    if (perf->available) {
+        double values[PERF_EVENT_COUNT];
+        for (int i = 0; i < PERF_EVENT_COUNT; i++) {
+            values[i] = perf_read_scaled(&perf->events[i]);
+        }
+        sample.core_cycles_per_op = values[0] / (double)operations;
+        sample.instructions_per_op = values[1] / (double)operations;
+        sample.branches_per_op = values[2] / (double)operations;
+        sample.branch_misses_per_kop = values[3] * 1000.0 / (double)operations;
+        sample.cache_misses_per_kop = values[4] * 1000.0 / (double)operations;
+    }
+    return sample;
+}
+
+static int compare_double(const void* left, const void* right) {
+    double a = *(const double*)left;
+    double b = *(const double*)right;
+    return (a > b) - (a < b);
+}
+
+static double quantile(const double* source, int count, double q) {
+    double* values = malloc((size_t)count * sizeof(*values));
+    if (!values) exit(1);
+    memcpy(values, source, (size_t)count * sizeof(*values));
+    qsort(values, (size_t)count, sizeof(*values), compare_double);
+    double position = q * (double)(count - 1);
+    int lower = (int)floor(position);
+    int upper = (int)ceil(position);
+    double fraction = position - (double)lower;
+    double result = values[lower] + (values[upper] - values[lower]) * fraction;
+    free(values);
+    return result;
+}
+
+static const char* hybrid_core_type(void) {
+    unsigned int max_leaf = __get_cpuid_max(0, NULL);
+    if (max_leaf < 0x1a) return "cpuid-leaf-unavailable";
+    unsigned int eax;
+    unsigned int ebx;
+    unsigned int ecx;
+    unsigned int edx;
+    __cpuid_count(0x1a, 0, eax, ebx, ecx, edx);
+    unsigned int type = eax >> 24;
+    if (type == 0x40) return "intel-core-p";
+    if (type == 0x20) return "intel-atom-e";
+    if (type == 0) return "not-exposed";
+    return "unknown";
+}
+
+static void print_metadata(const Options* options, const PerfGroup* perf) {
+    struct utsname info;
+    if (uname(&info) != 0) memset(&info, 0, sizeof(info));
+    printf("META reportable=%s runs=%d duration_ms=%.3f cpu_requested=%d "
+           "cpu_observed=%d core_type=%s\n",
+           options->quick_mode ? "no" : "yes", options->runs,
+           (double)options->duration_ns / 1e6, options->cpu, sched_getcpu(),
+           hybrid_core_type());
+    printf("META compiler=%s avx2_build=%s active_simd=%s\n",
+           __VERSION__,
+#ifdef __AVX2__
+           "yes",
+#else
+           "no",
+#endif
+           skibidi_get_active_simd());
+    printf("META kernel=%s release=%s machine=%s perf_hardware=%s",
+           info.sysname, info.release, info.machine,
+           perf->available ? "available" : "unavailable");
+    if (!perf->available) printf(" perf_errno=%d perf_error=%s",
+                                 perf->error_number, strerror(perf->error_number));
+    printf("\n");
+    printf("META tsc_note=serialized_reference_cycles_not_actual_core_cycles "
+           "dram_requested_mib=%.3f\n", (double)options->dram_bytes / (1u << 20));
+}
+
+static void run_case(CaseId id, const Options* options, PerfGroup* perf) {
+    Workload workload = make_workload(id, options->dram_bytes);
+    if ((is_batch_case(id) || is_control_case(id)) &&
+        strcmp(skibidi_get_active_simd(), "AVX2") != 0) {
+        fprintf(stderr, "%s requires an active AVX2 build, observed %s\n",
+                workload.name, skibidi_get_active_simd());
+        exit(1);
+    }
+
+    printf("CASE name=%s batch_count=%u slots=%zu output_stride=%zu "
+           "lengths_stride=%zu workset_bytes=%zu\n",
+           workload.name, workload.batch_count, workload.slot_count,
+           workload.output_stride, workload.lengths_stride, workload.total_bytes);
+    fflush(stdout);
+
+    warm_workload(&workload);
+    double bytes_per_op = estimate_bytes_per_op(&workload);
+    uint64_t calls = calibrated_calls(&workload, options->duration_ns);
+
+    Sample* samples = calloc((size_t)options->runs, sizeof(*samples));
+    double* throughputs = malloc((size_t)options->runs * sizeof(*throughputs));
+    double* latencies = malloc((size_t)options->runs * sizeof(*latencies));
+    double* tsc_cycles = malloc((size_t)options->runs * sizeof(*tsc_cycles));
+    double* core_cycles = malloc((size_t)options->runs * sizeof(*core_cycles));
+    double* gbps = malloc((size_t)options->runs * sizeof(*gbps));
+    if (!samples || !throughputs || !latencies || !tsc_cycles ||
+        !core_cycles || !gbps) exit(1);
+
+    for (int run = 0; run < options->runs; run++) {
+        samples[run] = measure_sample(&workload, calls, run, bytes_per_op, perf);
+        throughputs[run] = samples[run].throughput;
+        latencies[run] = samples[run].latency_ns;
+        tsc_cycles[run] = samples[run].tsc_cycles_per_op;
+        core_cycles[run] = samples[run].core_cycles_per_op;
+        gbps[run] = samples[run].effective_gbps;
+        printf("RUN case=%s index=%d operations=%" PRIu64 " wall_s=%.9f "
+               "throughput_ops_s=%.3f latency_ns_op=%.6f "
+               "tsc_cycles=%" PRIu64 " tsc_cycles_op=%.6f "
+               "core_cycles_op=%.6f instructions_op=%.6f branches_op=%.6f "
+               "branch_misses_kop=%.6f cache_misses_kop=%.6f "
+               "bytes_op=%.6f effective_gbps=%.6f checksum=%016" PRIx64 "\n",
+               workload.name, run + 1, samples[run].operations,
+               samples[run].wall_seconds, samples[run].throughput,
+               samples[run].latency_ns, samples[run].tsc_cycles,
+               samples[run].tsc_cycles_per_op, samples[run].core_cycles_per_op,
+               samples[run].instructions_per_op, samples[run].branches_per_op,
+               samples[run].branch_misses_per_kop,
+               samples[run].cache_misses_per_kop, bytes_per_op,
+               samples[run].effective_gbps, samples[run].checksum);
+        fflush(stdout);
+    }
+
+    printf("SUMMARY case=%s runs=%d throughput_median=%.3f throughput_p5=%.3f "
+           "throughput_p95=%.3f latency_median_ns=%.6f latency_p95_ns=%.6f "
+           "tsc_cycles_op_median=%.6f core_cycles_op_median=%.6f "
+           "effective_gbps_median=%.6f bytes_op=%.6f\n",
+           workload.name, options->runs,
+           quantile(throughputs, options->runs, 0.50),
+           quantile(throughputs, options->runs, 0.05),
+           quantile(throughputs, options->runs, 0.95),
+           quantile(latencies, options->runs, 0.50),
+           quantile(latencies, options->runs, 0.95),
+           quantile(tsc_cycles, options->runs, 0.50),
+           perf->available ? quantile(core_cycles, options->runs, 0.50) : NAN,
+           quantile(gbps, options->runs, 0.50), bytes_per_op);
+    fflush(stdout);
+
+    free(gbps);
+    free(core_cycles);
+    free(tsc_cycles);
+    free(latencies);
+    free(throughputs);
+    free(samples);
+    free_workload(&workload);
+}
+
+int main(int argc, char** argv) {
+    Options options = parse_options(argc, argv);
+    pin_to_cpu(options.cpu);
+
+    SkibidiConfig config = {0};
+    config.enable_simd_rng = 1;
+    if (skibidi_configure(&config) != SKIBIDI_OK) {
+        fprintf(stderr, "skibidi_configure failed\n");
+        return 1;
+    }
+
+    PerfGroup perf = perf_group_open();
+    print_metadata(&options, &perf);
+    for (CaseId id = 0; id < CASE_COUNT; id++) {
+        if (options.selected_cases & case_bit(id)) run_case(id, &options, &perf);
+    }
+    printf("FINAL checksum_sink=%016" PRIx64 "\n", checksum_sink);
+    perf_group_close(&perf);
+    return 0;
+}
