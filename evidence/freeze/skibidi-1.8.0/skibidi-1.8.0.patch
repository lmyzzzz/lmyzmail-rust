+} while (0)
+
+static const char PROPHECY[] = "Skibidi dop dop dop yes yes!";
+
+typedef struct {
+    uint64_t generated;
+    uint64_t prophecy;
+    uint64_t prefix;
+    uint64_t dop_counts[6];
+    uint64_t dop_words;
+    uint64_t dom_words;
+    uint64_t uppercase_dop_words;
